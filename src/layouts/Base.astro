---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'White Owl Studio',
  description = 'Tales of courage in broken worlds. Stories made to last.',
  ogImage = '/ui/og-default.jpg',
} = Astro.props;

const siteUrl   = 'https://whiteowlhub.com';
const pageTitle = title === 'White Owl Studio' ? title : `${title} — White Owl Studio`;
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImageAbs = new URL(ogImage, siteUrl).href;

const orgSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'White Owl Studio',
  url: siteUrl,
  logo: `${siteUrl}/ui/logo.gif`,
  sameAs: [
    'https://www.instagram.com/whiteowlstudio',
    'https://www.youtube.com/shorts/pTbSSnQsZ2E',
    'https://www.facebook.com/profile.php?id=61590287245120',
    'https://www.linkedin.com/company/whiteowl-studio',
    'https://www.tiktok.com/@whiteowl376',
    'https://ko-fi.com/whiteowlanimation',
  ],
  founder: [
    { '@type': 'Person', name: 'Michael B. Jacob' },
    { '@type': 'Person', name: 'Oshrit Gedalya' },
  ],
  description: 'Animation production house — hand-crafted films about people navigating broken worlds.',
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050409" />
    <link rel="canonical" href={canonical} />
    <!-- Fonts — Cinzel (UI/headings) + Crimson Pro (body). Loaded here, not via CSS @import, so they don't block render. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Crimson+Pro:ital,wght@0,300;0,400;0,600;1,300;1,400&display=swap"
    />
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/ui/favicon.svg" />
    <link rel="icon" type="image/gif" href="/ui/logo.gif" />
    <!-- apple-touch-icon: add /ui/apple-touch-icon.png (180×180 PNG) when available -->
    <title>{pageTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:site_name"   content="White Owl Studio" />
    <meta property="og:url"         content={canonical} />
    <meta property="og:title"       content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImageAbs} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageAbs} />

    <!-- Organization structured data -->
    <script type="application/ld+json" set:html={orgSchema} />

    {/* Coming-soon gate: redirect all pages in production. Remove both lines to launch. */}
    {!import.meta.env.DEV && <style is:inline>html{'{'}visibility:hidden{'}'}</style>}
    {!import.meta.env.DEV && <script is:inline>window.location.replace('/coming-soon');</script>}
  </head>
  <body>
    <a href="#main-content" class="skip-to-main">Skip to content</a>
    <!-- Background grain: sparse, high-contrast, behind all UI -->
    <canvas id="grain-bg" aria-hidden="true"></canvas>
    <!-- Top grain: near-invisible dark texture above everything -->
    <canvas id="grain-top" aria-hidden="true"></canvas>
    <!-- Edge blur: gradient-faded backdrop-filter at top and bottom of viewport -->
    <div class="edge-blur edge-blur--top" aria-hidden="true"></div>
    <div class="edge-blur edge-blur--bottom" aria-hidden="true"></div>
    <!-- Top-center atmospheric vignette — fixed, sits below grain -->
    <div class="bg-vignette" aria-hidden="true"></div>
    <Nav />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <!-- Global single-image zoom lightbox — triggered by [data-zoom] on any page -->
    <div id="zoom-lb" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Full screen view">
      <div id="zoom-lb-bg"></div>
      <button id="zoom-lb-close" aria-label="Close">✕</button>
      <div id="zoom-lb-content"></div>
    </div>
  </body>
</html>

<style>
  .bg-vignette {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background: radial-gradient(ellipse 80% 55% at 50% -5%, rgba(32, 26, 56, 0.8) 0%, transparent 65%);
  }

  .skip-to-main {
    position: absolute;
    top: -100%;
    left: 1rem;
    padding: 0.5rem 1rem;
    background: var(--gold);
    color: var(--bg);
    font-family: 'Cinzel', serif;
    font-size: 0.77rem;
    letter-spacing: 0.1em;
    z-index: 10000;
    transition: top 0.15s;
  }
  .skip-to-main:focus { top: 1rem; }

  /* Behind all page content — only visible in open background areas */
  #grain-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    mix-blend-mode: screen;
  }

  /* ── Edge blur ──────────────────────────────────────────────────────────
     background gradient: dark→transparent reveals the blurred content
     gradually (same technique as the original nav).
     mask-image: fades the element itself to invisible at the inner edge,
     removing the hard cutoff line where the blur zone ends.              */
  .edge-blur {
    position: fixed;
    left: 0;
    right: 0;
    height: 72px;
    pointer-events: none;
    z-index: 10;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }

  .edge-blur--top {
    top: 0;
    background: linear-gradient(to bottom, rgba(5,4,9,0.30) 0%, rgba(5,4,9,0.0) 65%);
    mask-image: linear-gradient(to bottom, black 0%, black 35%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 35%, transparent 100%);
  }

  .edge-blur--bottom {
    bottom: 0;
    background: linear-gradient(to top, rgba(5,4,9,0.30) 0%, rgba(5,4,9,0.0) 65%);
    mask-image: linear-gradient(to top, black 0%, black 35%, transparent 100%);
    -webkit-mask-image: linear-gradient(to top, black 0%, black 35%, transparent 100%);
  }

  /* Whisper-thin dark texture sitting above everything */
  #grain-top {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9999;
    mix-blend-mode: overlay;
    opacity: 0.55;
  }
</style>

<script>
  // ── Background grain — sparse warm specks, 8 FPS ──
  const bgCanvas = document.getElementById('grain-bg') as HTMLCanvasElement;
  const bgCtx    = bgCanvas.getContext('2d')!;

  // ── Top grain — subtle dark static texture ──
  const topCanvas = document.getElementById('grain-top') as HTMLCanvasElement;
  const topCtx    = topCanvas.getContext('2d')!;

  let w = 0, h = 0;

  function resize() {
    w = bgCanvas.width  = topCanvas.width  = window.innerWidth;
    h = bgCanvas.height = topCanvas.height = window.innerHeight;
    drawTopGrain(); // static — only needs one draw
  }

  function drawBgGrain() {
    if (!w || !h) return;
    bgCtx.clearRect(0, 0, w, h);

    const count = (w * h * 0.0003) | 0;

    for (let i = 0; i < count; i++) {
      const x    = Math.random() * w;
      const y    = Math.random() * h;
      // Much smaller — sub-pixel to 0.6px radius
      const rx   = Math.random() * 0.45 + 0.08;
      // Slight shape displacement: vary y-radius and rotate
      const ry   = rx * (0.6 + Math.random() * 0.8);
      const rot  = Math.random() * Math.PI;
      // 50% of previous opacity range
      const a    = Math.random() * 0.22 + 0.14;
      const warm = (Math.random() * 25) | 0;

      bgCtx.beginPath();
      bgCtx.ellipse(x, y, rx, ry, rot, 0, 6.2832);
      bgCtx.fillStyle = `rgba(${215 + warm},${148 + (warm >> 1)},${52 + (warm >> 2)},${a})`;
      bgCtx.fill();
    }
  }

  function drawTopGrain() {
    if (!w || !h) return;
    topCtx.clearRect(0, 0, w, h);

    const count = (w * h * 0.004) | 0;

    for (let i = 0; i < count; i++) {
      const x  = Math.random() * w;
      const y  = Math.random() * h;
      // Tiny, sub-pixel
      const rx = Math.random() * 0.3 + 0.06;
      const ry = rx * (0.5 + Math.random() * 0.9);
      const rot = Math.random() * Math.PI;
      // 50% of previous opacity
      const a  = Math.random() * 0.035 + 0.005;

      topCtx.beginPath();
      topCtx.ellipse(x, y, rx, ry, rot, 0, 6.2832);
      topCtx.fillStyle = `rgba(10,8,18,${a})`;
      topCtx.fill();
    }
  }

  resize();
  window.addEventListener('resize', resize, { passive: true });

  // 6 FPS for the background grain — paused when tab is hidden
  let grainTimer = setInterval(drawBgGrain, 1000 / 6);
  drawBgGrain();

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      clearInterval(grainTimer);
    } else {
      grainTimer = setInterval(drawBgGrain, 1000 / 6);
      drawBgGrain();
    }
  });

  // ── Global zoom lightbox — any [data-zoom] image or video ──
  const zoomLb      = document.getElementById('zoom-lb')!;
  const zoomContent = document.getElementById('zoom-lb-content')!;
  const zoomClose   = document.getElementById('zoom-lb-close')!;
  const zoomBg      = document.getElementById('zoom-lb-bg')!;

  function openZoom(src: string, alt: string, isVideo: boolean) {
    zoomContent.innerHTML = '';
    let el: HTMLImageElement | HTMLVideoElement;
    if (isVideo) {
      el = document.createElement('video');
      (el as HTMLVideoElement).autoplay = true;
      (el as HTMLVideoElement).loop = true;
      (el as HTMLVideoElement).muted = true;
      (el as HTMLVideoElement).playsInline = true;
      (el as HTMLVideoElement).controls = true;
    } else {
      el = document.createElement('img');
      (el as HTMLImageElement).alt = alt;
    }
    el.src = src;
    el.className = 'zoom-media';
    zoomContent.appendChild(el);
    zoomLb.setAttribute('aria-hidden', 'false');
    zoomLb.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    zoomClose.focus();
  }

  function closeZoom() {
    zoomLb.setAttribute('aria-hidden', 'true');
    zoomLb.classList.remove('is-open');
    zoomContent.innerHTML = '';
    // Restore scroll only if no film modal is open beneath us
    if (!document.querySelector('.film-modal.is-open')) {
      document.body.style.overflow = '';
    }
  }

  document.querySelectorAll<HTMLElement>('[data-zoom]').forEach(el => {
    el.addEventListener('click', e => {
      e.stopPropagation();
      const src     = (el as HTMLImageElement).src ?? (el as HTMLVideoElement).src ?? '';
      const alt     = (el as HTMLImageElement).alt ?? '';
      const isVideo = el.tagName === 'VIDEO' || el.dataset.zoomType === 'video';
      openZoom(src, alt, isVideo);
    });
  });

  zoomBg.addEventListener('click', closeZoom);
  zoomClose.addEventListener('click', closeZoom);
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && zoomLb.classList.contains('is-open')) closeZoom();
  });

  // ── Drag-to-scroll — any [data-drag-rail] element on any page ──
  document.querySelectorAll<HTMLElement>('[data-drag-rail]').forEach(rail => {
    let isDown = false, startX = 0, scrollLeft = 0;
    rail.addEventListener('mousedown', e => {
      isDown = true; startX = e.pageX - rail.offsetLeft; scrollLeft = rail.scrollLeft;
    });
    document.addEventListener('mouseup', () => { isDown = false; });
    rail.addEventListener('mousemove', e => {
      if (!isDown) return;
      e.preventDefault();
      rail.scrollLeft = scrollLeft - (e.pageX - rail.offsetLeft - startX);
    });
  });
</script>
