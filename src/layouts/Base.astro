---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'White Owl Studio',
  description = 'Tales of courage in broken worlds. Stories made to last.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/gif" href="/ui/logo.gif" />
    <title>{title === 'White Owl Studio' ? title : `${title} — White Owl Studio`}</title>
  </head>
  <body>
    <canvas id="grain" aria-hidden="true"></canvas>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  #grain {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9998;
    mix-blend-mode: screen;
    opacity: 1;
  }
</style>

<script>
  const canvas = document.getElementById('grain') as HTMLCanvasElement;
  const ctx    = canvas.getContext('2d')!;
  let w = 0, h = 0;

  function resize() {
    w = canvas.width  = window.innerWidth;
    h = canvas.height = window.innerHeight;
  }

  function drawGrain() {
    if (!w || !h) return;
    ctx.clearRect(0, 0, w, h);

    // Scattered warm golden speckles — density ~0.28% of pixels
    const count = (w * h * 0.0028) | 0;

    for (let i = 0; i < count; i++) {
      const x    = Math.random() * w;
      const y    = Math.random() * h;
      const r    = Math.random() * 1.1 + 0.15;
      const a    = Math.random() * 0.14 + 0.02;
      const warm = (Math.random() * 30) | 0;

      ctx.beginPath();
      ctx.arc(x, y, r, 0, 6.2832);
      // Warm amber-gold tint matching the existing freckles
      ctx.fillStyle = `rgba(${210 + warm},${145 + (warm >> 1)},${50 + (warm >> 2)},${a})`;
      ctx.fill();
    }
  }

  resize();
  window.addEventListener('resize', resize, { passive: true });

  // 12 FPS = one new grain frame every ~83ms
  setInterval(drawGrain, 1000 / 12);
  drawGrain();
</script>
