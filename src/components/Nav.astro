---
import { categories } from '../data/portfolio';

const links = [
  { label: 'Our Films',        href: '/films',       accent: 'var(--accent-films)' },
  { label: 'Our Work',         href: '/portfolio',   accent: 'var(--accent-portfolio)' },
  { label: 'About Us',         href: '/about',       accent: 'var(--accent-about)' },
  { label: 'Our Shop',         href: '/shop',        accent: 'var(--accent-shop)' },
  { label: 'Online Playthings',href: '/experiences', accent: 'var(--accent-experiences)' },
  { label: 'The Coven',        href: '/coven',       accent: 'var(--accent-coven)' },
];

const currentPath = Astro.url.pathname;
---

<nav class="site-nav">
  <a href="/" class="nav-logo" aria-label="White Owl Studio — Home">
    <img src="/ui/logo.gif" alt="" width="44" height="44" />
    <span class="nav-studio-name">White Owl Studio</span>
  </a>

  <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu">
    <span></span><span></span><span></span>
  </button>

  <ul class="nav-links" id="nav-menu" role="list">
    {links.map(({ label, href, accent }) => (
      <li class:list={[{ 'nav-item--has-dropdown': label === 'Our Work' }]}>
        <a
          href={href}
          class:list={['nav-link', { active: currentPath.startsWith(href) }]}
          style={`--accent: ${accent}`}
        >
          {label}
        </a>

        {label === 'Our Work' && (
          <ul class="nav-dropdown">
            {categories.map(cat => (
              <li>
                <a
                  href={`/portfolio/${cat.slug}`}
                  class:list={['nav-dropdown-link', { active: currentPath === `/portfolio/${cat.slug}` }]}
                >
                  {cat.title}
                </a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
</nav>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 32px;
    height: 64px;
    background: linear-gradient(to bottom, rgba(5,4,9,0.95) 0%, rgba(5,4,9,0.0) 100%);
  }

  /* ── Logo ── */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    text-decoration: none;
  }

  .nav-logo img {
    display: block;
    width: 44px;
    height: 44px;
    object-fit: contain;
  }

  .nav-studio-name {
    font-family: 'Cinzel', serif;
    font-size: 0.77rem;
    font-weight: 400;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--bone);
    white-space: nowrap;
    opacity: 0.8;
  }

  /* ── Links ── */
  .nav-links {
    display: flex;
    list-style: none;
    gap: 28px;
    align-items: center;
  }

  .nav-link {
    font-family: 'Cinzel', serif;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    text-decoration: none;
    transition: color 0.25s;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--accent);
  }

  /* ── Portfolio dropdown — vertical list ── */
  .nav-item--has-dropdown {
    position: relative;
  }

  .nav-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    list-style: none;
    min-width: 200px;

    display: flex;
    flex-direction: column;

    background: rgba(10, 8, 20, 0.97);
    border: 1px solid rgba(245, 208, 96, 0.1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s ease, transform 0.22s ease;
    z-index: 200;
  }

  .nav-dropdown.is-open,
  .nav-item--has-dropdown:focus-within .nav-dropdown {
    opacity: 1;
    pointer-events: all;
    transform: translateX(-50%) translateY(0);
  }

  .nav-dropdown-link {
    font-family: 'Cinzel', serif;
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(245, 208, 96, 0.45);
    text-decoration: none;
    padding: 11px 22px;
    display: block;
    white-space: nowrap;
    border-bottom: 1px solid rgba(245, 208, 96, 0.07);
    transition: color 0.2s ease, background 0.2s ease;
  }

  .nav-dropdown > li:last-child .nav-dropdown-link { border-bottom: none; }

  .nav-dropdown-link:hover,
  .nav-dropdown-link.active {
    color: var(--gold);
    background: rgba(112, 64, 184, 0.15);
  }

  /* ── Mobile toggle ── */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    width: 32px;
    height: 32px;
  }

  .nav-toggle span {
    display: block;
    height: 1px;
    background: var(--gold);
    transition: transform 0.2s, opacity 0.2s;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .nav-dropdown,
    .nav-dropdown.is-open { display: none; }

    .site-nav {
      padding: 0 20px;
    }

    .nav-toggle {
      display: flex;
    }

    .nav-links {
      position: fixed;
      top: 64px;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: rgba(5,4,9,0.97);
      backdrop-filter: blur(8px);
      padding: 24px 0;
      transform: translateY(-100%);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.3s, opacity 0.3s;
    }

    .nav-links.open {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }

    .nav-links li {
      width: 100%;
      text-align: center;
    }

    .nav-link {
      display: block;
      padding: 16px 0;
      font-size: 0.77rem;
      letter-spacing: 0.3em;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle') as HTMLButtonElement;
  const links = document.querySelector('.nav-links') as HTMLElement;

  toggle?.addEventListener('click', () => {
    const open = links.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(open));
    links.setAttribute('aria-hidden', String(!open));
  });

  document.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', () => {
      links.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
      links.setAttribute('aria-hidden', 'true');
    });
  });

  // ── Dropdown: JS-managed hover with delay so cursor can reach the bar ──
  const ddTrigger = document.querySelector<HTMLElement>('.nav-item--has-dropdown');
  const ddEl      = document.querySelector<HTMLElement>('.nav-dropdown');
  let ddTimer: ReturnType<typeof setTimeout> | null = null;

  const openDd  = () => { if (ddTimer) { clearTimeout(ddTimer); ddTimer = null; } ddEl?.classList.add('is-open'); };
  const closeDd = () => { ddTimer = setTimeout(() => ddEl?.classList.remove('is-open'), 140); };

  ddTrigger?.addEventListener('mouseenter', openDd);
  ddTrigger?.addEventListener('mouseleave', closeDd);
  ddEl?.addEventListener('mouseenter', openDd);
  ddEl?.addEventListener('mouseleave', closeDd);

</script>
