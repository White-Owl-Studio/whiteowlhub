---
import Base from '../../layouts/Base.astro';
import { experiences } from '../../data/experiences';

export function getStaticPaths() {
  return experiences
    .filter(exp => exp.status === 'demo')
    .map(exp => ({
      params: { game: exp.id },
      props: { exp },
    }));
}

const { exp } = Astro.props;
const { swirlR: r, swirlG: g, swirlB: b } = exp;
---

<Base
  title={exp.title}
  description={`${exp.tagline} An interactive experience by White Owl Studio.`}
>

  <div
    class="game-shell"
    style={`--ar: ${r}; --ag: ${g}; --ab: ${b};`}
  >

    <nav class="game-nav">
      <a href="/experiences" class="nav-exit" aria-label="Exit game and return to experiences">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <line x1="13" y1="1" x2="1" y2="13" stroke="currentColor" stroke-width="1.2"/>
          <line x1="1"  y1="1" x2="13" y2="13" stroke="currentColor" stroke-width="1.2"/>
        </svg>
        Exit
      </a>
      <span class="nav-title">{exp.title}</span>
      <span class="nav-tag">White Owl Studio</span>
    </nav>

    <div class="game-frame-wrap">
      <iframe
        src={`/games/${exp.id}.html`}
        class="game-frame"
        title={`${exp.title} — ${exp.eyebrow}`}
        allow="autoplay"
        loading="eager"
      ></iframe>
    </div>

  </div>

</Base>

<style>
  /* Hide the site nav and footer on the game page */
  :global(nav.site-nav),
  :global(footer) {
    display: none !important;
  }

  .game-shell {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: #050409;
    z-index: 100;
  }

  /* Minimal top bar — accent color comes from the experience's swirl RGB */
  .game-nav {
    height: 40px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    padding: 0 1rem;
    gap: 1rem;
    border-bottom: 1px solid rgb(var(--ar) var(--ag) var(--ab) / 0.12);
    background: rgba(5,4,9,0.95);
    z-index: 10;
  }

  .nav-exit {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Cinzel', serif;
    font-size: 0.64rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(var(--ar) var(--ag) var(--ab) / 0.55);
    text-decoration: none;
    border: 1px solid rgb(var(--ar) var(--ag) var(--ab) / 0.2);
    padding: 0.3rem 0.75rem;
    transition: color 0.2s, border-color 0.2s;
    flex-shrink: 0;
  }
  .nav-exit:hover {
    color: rgb(var(--ar) var(--ag) var(--ab));
    border-color: rgb(var(--ar) var(--ag) var(--ab) / 0.5);
  }

  .nav-title {
    font-family: 'Cinzel', serif;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    color: rgb(var(--ar) var(--ag) var(--ab) / 0.7);
    flex: 1;
    text-align: center;
  }

  .nav-tag {
    font-family: 'Cinzel', serif;
    font-size: 0.57rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(245,208,96,0.3);
    flex-shrink: 0;
  }

  /* Game iframe — fills remaining height */
  .game-frame-wrap {
    flex: 1;
    overflow: hidden;
    position: relative;
  }

  .game-frame {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    background: #050409;
  }
</style>
