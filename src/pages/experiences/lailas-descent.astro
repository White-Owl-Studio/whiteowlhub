---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Laila's Descent"
  description="A horror shooter by White Owl Studio. She came looking for the exit. There isn't one."
>

  <div class="game-shell">

    <nav class="game-nav">
      <a href="/experiences" class="nav-exit" aria-label="Exit game and return to experiences">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <line x1="13" y1="1" x2="1" y2="13" stroke="currentColor" stroke-width="1.2"/>
          <line x1="1"  y1="1" x2="13" y2="13" stroke="currentColor" stroke-width="1.2"/>
        </svg>
        Exit
      </a>
      <span class="nav-title">Laila's Descent</span>
      <span class="nav-tag">White Owl Studio</span>
    </nav>

    <div class="game-frame-wrap">
      <iframe
        src="/games/lailas-descent.html"
        class="game-frame"
        title="Laila's Descent — a horror shooter"
        allow="autoplay"
        loading="eager"
      ></iframe>
    </div>

  </div>

</Base>

<style>
  /* Hide the site nav and footer on the game page */
  :global(nav.site-nav),
  :global(footer) {
    display: none !important;
  }

  .game-shell {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: #050409;
    z-index: 100;
  }

  /* Minimal top bar */
  .game-nav {
    height: 40px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    padding: 0 1rem;
    gap: 1rem;
    border-bottom: 1px solid rgba(238,34,34,0.12);
    background: rgba(5,4,9,0.95);
    z-index: 10;
  }

  .nav-exit {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Cinzel', serif;
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(238,34,34,0.55);
    text-decoration: none;
    border: 1px solid rgba(238,34,34,0.2);
    padding: 0.3rem 0.75rem;
    transition: color 0.2s, border-color 0.2s;
    flex-shrink: 0;
  }
  .nav-exit:hover {
    color: #ee2222;
    border-color: rgba(238,34,34,0.5);
  }

  .nav-title {
    font-family: 'Cinzel', serif;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: rgba(238,34,34,0.7);
    flex: 1;
    text-align: center;
  }

  .nav-tag {
    font-family: 'Cinzel', serif;
    font-size: 0.52rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(245,208,96,0.3);
    flex-shrink: 0;
  }

  /* Game iframe — fills remaining height */
  .game-frame-wrap {
    flex: 1;
    overflow: hidden;
    position: relative;
  }

  .game-frame {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    background: #050409;
  }
</style>
