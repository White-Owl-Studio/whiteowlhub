---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Lightbox from '../../components/Lightbox.astro';
import { categories } from '../../data/portfolio';
import type { Category } from '../../data/portfolio';

export const getStaticPaths: GetStaticPaths = () =>
  categories.map(cat => ({
    params: { category: cat.slug },
    props: { category: cat },
  }));

interface Props { category: Category; }
const { category } = Astro.props;

const catIndex = categories.findIndex(c => c.slug === category.slug);
const hasItems = category.items.length > 0;
const hasProjects = category.grid === 'project' && (category.projects?.length ?? 0) > 0;
---

<Base
  title={`${category.title} — Our Work`}
  description={`${category.description} — White Owl Studio`}
>

  <!-- ══════════════════════════════════════ HEADER ══ -->
  <section class="cat-hero">
    <div class="cat-hero-inner">
      <a href="/portfolio" class="back-link">← Our Work</a>
      <p class="eyebrow">0{catIndex + 1} · Our Work</p>
      <h1 class="cat-title">{category.title}</h1>
      <p class="cat-desc">{category.description}</p>
    </div>
  </section>

  <!-- ══════════════════════════════ SCROLL COLUMN ══ -->
  {category.grid === 'uniform' && category.layout === 'scroll' && (
    <section class="scroll-section">
      <div class="scroll-column">
        {category.items.map((item, i) => (
          <div
            class="scroll-item"
            data-lightbox-index={i}
            data-lightbox-trigger
            role="button"
            tabindex="0"
            aria-label={item.alt}
          >
            {item.type === 'video'
              ? <video src={item.src} autoplay loop muted playsinline class="scroll-media" />
              : <img src={item.src} alt={item.alt} loading="lazy" class="scroll-media" />
            }
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════ UNIFORM GRID ══ -->
  {category.grid === 'uniform' && category.layout !== 'scroll' && (
    <section class="grid-section">
      {hasItems
        ? (
          <div class="uniform-grid">
            {category.items.map((item, i) => (
              <div
                class="grid-thumb"
                data-lightbox-index={i}
                data-lightbox-trigger
                role="button"
                tabindex="0"
                aria-label={item.alt}
              >
                {item.type === 'video'
                  ? <video src={item.src} autoplay loop muted playsinline class="thumb-media" />
                  : <img src={item.src} alt={item.alt} loading="lazy" class="thumb-media" />
                }
              </div>
            ))}
          </div>
        )
        : (
          <div class="empty-state">
            <p class="empty-text">Work coming soon.</p>
            <a href="/portfolio" class="empty-back">← Back to Our Work</a>
          </div>
        )
      }
    </section>
  )}

  <!-- ══════════════════════════════ PROJECT GRID ══ -->
  {category.grid === 'project' && (
    <section class="grid-section">
      {hasProjects
        ? (
          <div class="project-list">
            {(category.projects ?? []).map(project => (
              <div class="project-card" data-project={project.slug}>
                <div class="project-header">
                  <h2 class="project-name">{project.name}</h2>
                  <span class="project-count">
                    {project.items.length > 0 ? `${project.items.length} pieces` : 'Coming soon'}
                  </span>
                </div>
                {project.items.length > 0 && (
                  project.items.length > 4 ? (
                    <div class="project-rail drag-rail" data-drag-rail>
                      {project.items.map((item, i) => (
                        <div
                          class="rail-thumb"
                          data-lightbox-index={i}
                          data-lightbox-trigger={project.slug}
                          role="button"
                          tabindex="0"
                          aria-label={item.alt}
                        >
                          {item.type === 'video'
                            ? <video src={item.src} autoplay loop muted playsinline class="thumb-media" />
                            : <img src={item.src} alt={item.alt} loading="lazy" class="thumb-media" />
                          }
                        </div>
                      ))}
                    </div>
                  ) : (
                    <div class="project-thumbs">
                      {project.items.map((item, i) => (
                        <div
                          class="grid-thumb"
                          data-lightbox-index={i}
                          data-lightbox-trigger={project.slug}
                          role="button"
                          tabindex="0"
                          aria-label={item.alt}
                        >
                          {item.type === 'video'
                            ? <video src={item.src} autoplay loop muted playsinline class="thumb-media" />
                            : <img src={item.src} alt={item.alt} loading="lazy" class="thumb-media" />
                          }
                        </div>
                      ))}
                    </div>
                  )
                )}
              </div>
            ))}
          </div>
        )
        : (
          <div class="empty-state">
            <p class="empty-text">Client work coming soon.</p>
            <a href="/portfolio" class="empty-back">← Back to Our Work</a>
          </div>
        )
      }
    </section>
  )}

  <Lightbox items={category.items} />

</Base>

<style>
  /* ══════════════════════════════════════ HEADER ══ */
  .cat-hero {
    padding: clamp(100px, 14vw, 160px) var(--section-px) clamp(32px, 4vw, 56px);
    position: relative;
    z-index: 2;
    border-bottom: 1px solid rgba(245, 208, 96, 0.07);
  }

  .cat-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 720px;
  }

  .back-link {
    font-family: 'Cinzel', serif;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--violet-faint);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 8px;
    transition: color 0.2s ease;
  }

  .back-link:hover { color: var(--accent-portfolio); }

  .cat-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(2rem, 4.5vw, 3.8rem);
    color: var(--gold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1;
    transition: color 0.2s ease;
  }

  .cat-title:hover { color: var(--accent-portfolio); }

  .cat-desc {
    font-family: 'Crimson Pro', serif;
    font-style: italic;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    color: rgba(245, 208, 96, 0.4);
    line-height: 1.65;
  }

  /* ══════════════════════════════════ SCROLL LAYOUT ══ */
  .scroll-section {
    display: flex;
    justify-content: center;
    padding: clamp(24px, 3vw, 48px) 0 var(--section-py);
    position: relative;
    z-index: 2;
  }

  .scroll-column {
    width: min(88%, 1100px);
    display: flex;
    flex-direction: column;
  }

  .scroll-item {
    cursor: zoom-in;
    display: block;
    line-height: 0; /* collapse inline whitespace between images */
  }

  .scroll-media {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ══════════════════════════════════ GRID SECTION ══ */
  .grid-section {
    padding: clamp(40px, 5vw, 72px) var(--section-px) var(--section-py);
    position: relative;
    z-index: 2;
  }

  /* Uniform grid */
  .uniform-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }

  .grid-thumb {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    background: #0d0a14;
    aspect-ratio: 4 / 3;
  }

  .thumb-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .grid-thumb:hover .thumb-media {
    transform: scale(1.05);
  }

  /* Project grid */
  .project-list {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .project-card {
    border-top: 1px solid rgba(245, 208, 96, 0.1);
    padding-top: 24px;
  }

  .project-header {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 20px;
  }

  .project-name {
    font-family: 'Cinzel', serif;
    font-size: clamp(1rem, 2vw, 1.4rem);
    color: var(--gold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .project-card:hover .project-name { color: var(--accent-portfolio); }

  .project-count {
    font-family: 'Crimson Pro', serif;
    font-style: italic;
    font-size: 0.94rem;
    color: rgba(245, 208, 96, 0.3);
  }

  .project-thumbs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
  }

  /* Rail — for projects with >4 items */
  .project-rail {
    gap: 6px;
    padding: 8px 0 20px;
  }

  .rail-thumb {
    flex: 0 0 auto;
    width: clamp(180px, 24vw, 280px);
    aspect-ratio: 4 / 3;
    overflow: hidden;
    cursor: zoom-in;
    background: #0d0a14;
  }

  .rail-thumb .thumb-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .rail-thumb:hover .thumb-media {
    transform: scale(1.05);
  }

  /* Empty state */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: clamp(60px, 10vw, 120px) 0;
    border: 1px solid rgba(245, 208, 96, 0.07);
  }

  .empty-text {
    font-family: 'Crimson Pro', serif;
    font-style: italic;
    font-size: 1.1rem;
    color: rgba(245, 208, 96, 0.25);
  }

  .empty-back {
    font-family: 'Cinzel', serif;
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--violet-faint);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .empty-back:hover { color: var(--accent-portfolio); }

  /* ══════════════════════════════════════ LIGHTBOX ══ */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .lightbox.is-open {
    opacity: 1;
    pointer-events: all;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 4, 9, 0.96);
    cursor: pointer;
  }

  .lightbox-media-wrap {
    position: relative;
    z-index: 1;
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.lightbox-media) {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    display: block;
  }

  .lightbox-close {
    position: absolute;
    top: 24px;
    right: 28px;
    z-index: 2;
    background: transparent;
    border: 1px solid rgba(245, 208, 96, 0.2);
    color: rgba(245, 208, 96, 0.6);
    font-size: 0.9rem;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 2px;
    transition: color 0.2s, border-color 0.2s;
  }

  .lightbox-close:hover {
    color: var(--accent-portfolio);
    border-color: var(--violet-faint);
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    background: transparent;
    border: 1px solid rgba(245, 208, 96, 0.15);
    color: rgba(245, 208, 96, 0.5);
    font-size: 1.8rem;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 2px;
    transition: color 0.2s, border-color 0.2s;
    line-height: 1;
  }

  .lightbox-nav:hover {
    color: var(--accent-portfolio);
    border-color: var(--violet-faint);
  }

  .lightbox-prev { left: 24px; }
  .lightbox-next { right: 24px; }

  .lightbox-counter {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    font-family: 'Cinzel', serif;
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    color: rgba(245, 208, 96, 0.3);
  }

  /* ══════════════════════════════════════ RESPONSIVE ══ */
  @media (max-width: 900px) {
    .uniform-grid { grid-template-columns: repeat(2, 1fr); }
    .project-thumbs { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .uniform-grid { grid-template-columns: 1fr; }
    .project-thumbs { grid-template-columns: repeat(2, 1fr); }
  }
</style>
