---
import Base from '../layouts/Base.astro';
import { experiences as rawExperiences } from '../data/experiences';

const experiences = rawExperiences.map(e => ({
  ...e,
  url: e.status === 'demo' ? `/experiences/${e.id}` : null,
}));
---

<Base title="Online Playthings" description="Interactive browser experiences from White Owl Studio — games, worlds, and hidden things. Press the orb to see what you find.">

  <section class="xp-hero">

    <h1 class="sr-only">Online Playthings</h1>
    <p class="eyebrow" aria-hidden="true">Online Playthings</p>

    <div class="orb-stage">

      <button
        class="orb-wrap"
        id="orb-wrap"
        type="button"
        aria-label="Press to reveal an experience from White Owl Studio"
      >
        <canvas id="orb-canvas" aria-hidden="true"></canvas>
        <div class="orb-rim" id="orb-rim" aria-hidden="true"></div>
      </button>

      <div class="orb-reveal" id="orb-reveal" aria-hidden="true">
        <p class="reveal-eyebrow" id="reveal-eyebrow"></p>
        <h2 class="reveal-title"  id="reveal-title"></h2>
        <button class="btn-reshuffle" id="btn-reshuffle" type="button" aria-label="Try a different experience" aria-hidden="true">↺ &thinsp;draw again</button>
      </div>

    </div>

  </section>

</Base>

<style>
  .xp-hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--section-py) var(--section-px);
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  .eyebrow {
    font-family: 'Cinzel', serif;
    font-size: 0.84rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--accent-experiences);
    opacity: 0.8;
    text-align: center;
  }

  /* ════════════ ORB ════════════ */
  .orb-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  .orb-wrap {
    --orb-size: clamp(280px, 50vmin, 520px);
    position: relative;
    width: var(--orb-size);
    height: var(--orb-size);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    border-radius: 50%;
    outline: none;
    flex-shrink: 0;
  }
  .orb-wrap:focus-visible { box-shadow: 0 0 0 3px rgba(160,80,220,0.5); }

  #orb-canvas {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }

  /* Aurora rim — no hard outline, soft planetary glow */
  .orb-rim {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
    /* No border, only diffuse glow */
    box-shadow:
      0 0 48px 18px rgba(110,40,200,0.22),
      0 0 90px  32px rgba(80,20,160,0.14),
      0 0 150px 50px rgba(50,10,110,0.07);
    animation: aurora-breathe 5s ease-in-out infinite;
    transition: box-shadow 0.7s ease;
  }
  @keyframes aurora-breathe {
    0%, 100% { opacity: 0.75; }
    50%       { opacity: 1; }
  }
  .orb-wrap:hover .orb-rim {
    box-shadow:
      0 0 60px 22px rgba(130,50,220,0.30),
      0 0 110px 40px rgba(90,25,180,0.18),
      0 0 180px 60px rgba(60,10,130,0.09);
  }

  /* ════════════ REVEAL PANEL ════════════ */
  .orb-reveal {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    text-align: center;
    min-height: 130px;
    justify-content: center;
    max-width: 480px;
    transition: opacity 0.4s ease;
  }
  .orb-reveal[aria-hidden='true']  { opacity: 0; pointer-events: none; }
  .orb-reveal[aria-hidden='false'] { opacity: 1; }

  .reveal-eyebrow {
    font-family: 'Cinzel', serif;
    font-size: 0.66rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--reveal-color, var(--accent-experiences));
    opacity: 0.75;
    min-height: 1em;
  }
  .reveal-title {
    font-family: 'Cinzel', serif;
    font-size: 2.4rem;
    font-weight: 400;
    color: var(--text);
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    text-shadow: 0 0 32px var(--reveal-color, transparent);
  }
  .btn-reshuffle {
    font-family: 'Cinzel', serif;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: none;
    border: 1px solid var(--reveal-color, rgba(245,208,96,0.25));
    color: var(--reveal-color, rgba(245,208,96,0.5));
    opacity: 0.45;
    padding: 0.55rem 1.75rem;
    cursor: pointer;
    transition: opacity 0.22s;
    margin-top: 0.65rem;
  }
  .btn-reshuffle:hover { opacity: 1; }
  .btn-reshuffle[aria-hidden='true'] { display: none; }

  @media (max-width: 480px) {
    .xp-hero { justify-content: flex-start; padding-top: clamp(80px, 15vw, 120px); }
  }
</style>

<script define:vars={{ experiences }}>
(function () {
  /* ─── DOM ──────────────────────────────────────────────────────────── */
  const wrap        = document.getElementById('orb-wrap');
  const canvas      = document.getElementById('orb-canvas');
  const rim         = document.getElementById('orb-rim');
  const revPanel    = document.getElementById('orb-reveal');
  const revEye      = document.getElementById('reveal-eyebrow');
  const revTitle    = document.getElementById('reveal-title');
  const btnReshuffle= document.getElementById('btn-reshuffle');
  if (!canvas || !wrap) return;

  /* ─── Canvas init ───────────────────────────────────────────────────── */
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  const CSS = wrap.clientWidth;
  canvas.width  = CSS * dpr;
  canvas.height = CSS * dpr;
  const ctx = canvas.getContext('2d');
  ctx.scale(dpr, dpr);
  const W = CSS, H = CSS, CX = W / 2, CY = H / 2, R = W * 0.48;

  /* ─── State ─────────────────────────────────────────────────────────── */
  let state       = 'idle';
  let currentExp  = null;
  let pendingExp  = null;
  let revAlpha    = 0;
  let bgAlpha     = 0;    // 0 = neutral purple, 1 = experience bg
  let swirlParts  = [];
  let swirlStart  = 0;
  let swirlDir    = 'inward';
  let swirlDur    = 960;
  let swirlCol    = [100, 40, 200];
  let secretTimer = null;
  let shineAlpha  = 0;
  let shineStart  = 0;
  const shineDur  = 450;

  /* ─── Neutral background: dark purple fog wisps + glitter ──────────── */
  const fogWisps = Array.from({ length: 5 }, (_, i) => ({
    ang:   (i / 5) * Math.PI * 2,
    rad:   R * (0.18 + i * 0.10),
    dAng:  (0.00022 + i * 0.00007) * (i % 2 ? 1 : -1),
    sz:    R * (0.55 + i * 0.10),
    op:    0.045 + i * 0.012,
  }));

  const neutralGlitter = Array.from({ length: 48 }, () => ({
    ang:  Math.random() * Math.PI * 2,
    rad:  R * (0.08 + Math.random() * 0.72),
    dAng: (0.0005 + Math.random() * 0.0009) * (Math.random() > 0.5 ? 1 : -1),
    sz:   0.5 + Math.random() * 1.8,
    op:   0.12 + Math.random() * 0.42,
    hue:  255 + Math.floor(Math.random() * 60),
  }));

  /* Zone 1 sediment — matches game's initZoneParticles(1) */
  const zone1Parts = Array.from({ length: 55 }, () => ({
    x: CX + (Math.random() - 0.5) * R * 1.9,
    y: CY - R + Math.random() * (R * 2),
    spd: 0.08 + Math.random() * 0.28,
    r:   0.4  + Math.random() * 1.1,
    a:   0.06 + Math.random() * 0.18,
  }));

  function drawNeutralBg(alpha) {
    fogWisps.forEach(w => { w.ang += w.dAng; });
    neutralGlitter.forEach(p => { p.ang += p.dAng; });
    if (alpha <= 0.01) return;

    ctx.save();
    ctx.globalAlpha = alpha;

    // Deep void base
    const base = ctx.createRadialGradient(CX, CY, 0, CX, CY, R);
    base.addColorStop(0,   '#1a0830');
    base.addColorStop(0.6, '#0b031a');
    base.addColorStop(1,   '#05020c');
    ctx.fillStyle = base;
    ctx.fillRect(0, 0, W, H);

    // Smoke plumes — large fillRect-based radial gradients, NOT arcs
    // This fills the whole canvas with each gradient so edges fade naturally (no visible circles)
    fogWisps.forEach(w => {
      const wx = CX + Math.cos(w.ang) * w.rad * 0.28;
      const wy = CY + Math.sin(w.ang) * w.rad * 0.28;
      const plume = ctx.createRadialGradient(wx, wy, 0, wx, wy, R * 1.15);
      plume.addColorStop(0,   `rgba(110,28,200,${w.op * 0.9})`);
      plume.addColorStop(0.4, `rgba(65,8,140,${w.op * 0.5})`);
      plume.addColorStop(1,   'rgba(15,3,40,0)');
      ctx.fillStyle = plume;
      ctx.fillRect(0, 0, W, H);
    });

    // Fine glitter sparkles
    neutralGlitter.forEach(p => {
      const px = CX + Math.cos(p.ang) * p.rad;
      const py = CY + Math.sin(p.ang) * p.rad;
      ctx.beginPath();
      ctx.arc(px, py, p.sz, 0, Math.PI * 2);
      ctx.fillStyle = `hsla(${p.hue},70%,78%,${p.op})`;
      ctx.fill();
    });

    ctx.restore();
  }

  function drawExpBg(exp, alpha, ts) {
    // Always advance Zone 1 sediment regardless of alpha
    zone1Parts.forEach(p => {
      p.y -= p.spd; // upward drift (disorienting, matches game)
      if (p.y < CY - R) { p.y = CY + R * 0.95; p.x = CX + (Math.random()-0.5)*R*1.8; }
    });

    if (alpha <= 0.01) return;
    ctx.save();

    if (exp.id === 'lailas-descent') {
      /* Zone 1 Still Water — exact palette from game's drawBg_stillWater */
      ctx.globalAlpha = alpha;

      // Linear gradient: #060c16 → #050a14 → #020408
      const g = ctx.createLinearGradient(0, CY - R, 0, CY + R);
      g.addColorStop(0,   '#060c16');
      g.addColorStop(0.5, '#050a14');
      g.addColorStop(1,   '#020408');
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, W, H);

      // Cold light from above (radial, centred just above the orb top)
      const ls = 0.24;
      const lg = ctx.createRadialGradient(CX, CY - R * 0.92, 0, CX, CY - R * 0.85, R * 1.1);
      lg.addColorStop(0, `rgba(184,212,240,${ls})`);
      lg.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = lg;
      ctx.fillRect(0, 0, W, H);

      // Sediment (upward-drifting particles)
      zone1Parts.forEach(p => {
        ctx.globalAlpha = alpha * p.a;
        ctx.fillStyle = '#8ab0cc';
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
      });

    } else if (exp.id === 'drive-that-truck') {
      /* Arava Desert Night — indigo sky + pixel-art stars + ground */
      ctx.globalAlpha = alpha;

      const groundY = CY + R * 0.40;

      // Three-band indigo sky
      const sky = ctx.createLinearGradient(0, CY - R, 0, groundY);
      sky.addColorStop(0,    '#1f1640');
      sky.addColorStop(0.35, '#241a48');
      sky.addColorStop(0.72, '#2a2052');
      sky.addColorStop(1,    '#2a2052');
      ctx.fillStyle = sky; ctx.fillRect(0, 0, W, H);

      // Ground strip
      ctx.fillStyle = '#0c081e'; ctx.fillRect(0, groundY, W, H);
      ctx.fillStyle = '#221a3a'; ctx.fillRect(0, groundY, W, 1);

      // Road centre-line dashes
      ctx.fillStyle = '#8a7aa0';
      const dashY = groundY + R * 0.09;
      for (let dx = 0; dx < W; dx += 18) ctx.fillRect(dx, Math.floor(dashY), 8, 1);

      // Crescent moon (upper-right quadrant)
      const mX = CX + R * 0.48, mY = CY - R * 0.58, mR = R * 0.068;
      ctx.fillStyle = '#dad4c8';
      for (let py = -Math.ceil(mR); py <= Math.ceil(mR); py++) {
        for (let px = -Math.ceil(mR); px <= Math.ceil(mR); px++) {
          if (px*px + py*py > mR*mR) continue;
          const ox = mR*0.42, oy = -mR*0.08;
          if ((px-ox)*(px-ox)+(py-oy)*(py-oy) < (mR*0.80)*(mR*0.80)) continue;
          ctx.fillRect(Math.floor(mX+px), Math.floor(mY+py), 1, 1);
        }
      }

      // Child's-drawing star grid — deterministic dots and plus-signs
      ctx.fillStyle = '#f0ece4';
      const sDX = R * 0.115, sDY = R * 0.092;
      let sRow = 0;
      for (let sy = CY - R * 0.88; sy < groundY - R * 0.15; sy += sDY, sRow++) {
        let sCol = 0;
        for (let sx = CX - R * 0.92; sx < CX + R * 0.92; sx += sDX, sCol++) {
          const k = ((sCol + sRow * 3) % 6 + 6) % 6;
          const px = Math.floor(sx), py = Math.floor(sy);
          if (k === 0) {
            ctx.fillRect(px-1, py, 3, 1); ctx.fillRect(px, py-1, 1, 3); // big +
          } else if (k === 1 || k === 3) {
            ctx.fillRect(px-1, py, 3, 1); ctx.fillRect(px, py-1, 1, 3); // small +
          } else {
            ctx.fillRect(px, py, 1, 1); // dot
          }
        }
      }

    } else {
      /* Generic tinted atmosphere for other experiences */
      ctx.globalAlpha = alpha;
      const r = exp.swirlR, g = exp.swirlG, b = exp.swirlB;
      const bg = ctx.createRadialGradient(CX, CY - R*0.1, 0, CX, CY, R);
      bg.addColorStop(0,    `rgba(${Math.round(r*0.32)},${Math.round(g*0.08)},${Math.round(b*0.08)},1)`);
      bg.addColorStop(0.55, `rgba(${Math.round(r*0.14)},${Math.round(g*0.04)},${Math.round(b*0.04)},1)`);
      bg.addColorStop(1,    'rgba(4,3,8,1)');
      ctx.fillStyle = bg;
      ctx.fillRect(0, 0, W, H);
    }

    ctx.restore();
  }

  /* ─── Swirl particles ───────────────────────────────────────────────── */
  function spawnSwirl(dir, col, n = 92) {
    swirlParts = [];
    swirlCol   = col;
    for (let i = 0; i < n; i++) {
      const ang    = Math.random() * Math.PI * 2;
      const startR = dir === 'inward' ? R*(0.80+Math.random()*0.18) : R*(0.01+Math.random()*0.06);
      const endR   = dir === 'inward' ? R*(0.01+Math.random()*0.05) : R*(0.78+Math.random()*0.20);
      swirlParts.push({
        ang, startR, endR, curR: startR,
        dAng: (dir === 'inward' ? 1 : -1) * (0.018 + Math.random() * 0.04),
        sz:   0.7 + Math.random() * 2.4,
        op:   0.35 + Math.random() * 0.60,
      });
    }
  }

  function drawSwirl(elapsed) {
    if (!swirlParts.length) return;
    const prog = Math.min(elapsed / swirlDur, 1);
    const ease = swirlDir === 'inward'
      ? 1 - Math.pow(1 - prog, 2.8)
      : Math.pow(prog, 1.8);
    const [sr, sg, sb] = swirlCol;

    swirlParts.forEach(p => {
      p.ang  += p.dAng;
      p.curR  = p.startR + (p.endR - p.startR) * ease;
      const fadeOp = p.op * (1 - Math.pow(prog, 1.6));
      if (fadeOp < 0.02) return;
      const px = CX + Math.cos(p.ang) * p.curR;
      const py = CY + Math.sin(p.ang) * p.curR;
      // Halo
      ctx.save();
      ctx.globalAlpha = fadeOp * 0.3;
      ctx.beginPath();
      ctx.arc(px, py, p.sz * 3.2, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${sr},${sg},${sb},0.5)`;
      ctx.fill();
      ctx.restore();
      // Core spark
      ctx.beginPath();
      ctx.arc(px, py, p.sz, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${sr},${sg},${sb},${fadeOp})`;
      ctx.fill();
    });
  }

  /* ─── Catmull-Rom — exact copy of game's _crPath ──────────────────── */
  function crPath(pts, ox, oy) {
    const n = pts.length, a = 1/6;
    ctx.moveTo((ox||0)+pts[0][0], (oy||0)+pts[0][1]);
    for (let i = 0; i < n-1; i++) {
      const p0=pts[Math.max(0,i-1)], p1=pts[i], p2=pts[i+1], p3=pts[Math.min(n-1,i+2)];
      ctx.bezierCurveTo(
        (ox||0)+p1[0]+a*(p2[0]-p0[0]), (oy||0)+p1[1]+a*(p2[1]-p0[1]),
        (ox||0)+p2[0]-a*(p3[0]-p1[0]), (oy||0)+p2[1]-a*(p3[1]-p1[1]),
        (ox||0)+p2[0], (oy||0)+p2[1]
      );
    }
  }

  /* Exact game constants */
  const _L1 = [[4,-4.3],[17.8,-8.5],[25.5,-19.1],[17.8,-18.1],[6,-24.9],[0,-23.6],
               [-6,-24.9],[-17.8,-18.1],[-25.5,-19.1],[-17.8,-8.5],[-4,-4.3],[0,4],[4,-4.3]];
  const _L2 = [[11.8,-10.6],[5,-22],[0,-17.8],[5,-13],[11.8,-10.6]];

  /* ─── Laila sprite — same drawing approach as game's drawPlayer ──── */
  function drawLaila(alpha, ts) {
    if (alpha <= 0.01) return;

    const floatY = Math.sin(ts * 0.0009) * 2; // ±2 game units, gentle float
    const s = R / 85; // smaller scale

    ctx.save();
    ctx.globalAlpha = alpha;
    // Lower-middle of orb
    ctx.translate(CX, CY + R * 0.28);
    ctx.scale(s, s);
    ctx.translate(0, floatY);

    function glow(col, blur) { ctx.shadowColor = col; ctx.shadowBlur = blur * s; }
    function noGlow() { ctx.shadowBlur = 0; }

    // ── L1 HAIR (behind face) ──
    glow('#ff2222', 8); ctx.fillStyle = '#ee2222';
    ctx.beginPath(); crPath(_L1); ctx.closePath(); ctx.fill();
    noGlow();
    // Left shadow overlay
    ctx.fillStyle = 'rgba(80,0,0,0.18)';
    ctx.beginPath();
    ctx.moveTo(0,-23.6);
    ctx.quadraticCurveTo(-3,-24.9,-6,-24.9);
    ctx.quadraticCurveTo(-10.7,-18.1,0,-4.3);
    ctx.closePath(); ctx.fill();
    // Right highlight
    ctx.fillStyle = 'rgba(255,100,60,0.10)';
    ctx.beginPath();
    ctx.moveTo(0,-23.6);
    ctx.quadraticCurveTo(3,-24.9,6,-24.9);
    ctx.quadraticCurveTo(10.7,-18.1,0,-4.3);
    ctx.closePath(); ctx.fill();

    // ── FEET ──
    ctx.fillStyle = '#f0dcc8';
    ctx.fillRect(-3.5,18,3,6); ctx.fillRect(0.5,18,3,6);
    ctx.fillStyle = 'rgba(8,0,0,0.65)';
    ctx.fillRect(-3.5,18,3,1.5); ctx.fillRect(0.5,18,3,1.5);

    // ── HANDS ──
    ctx.fillStyle = '#0d0808';
    ctx.beginPath(); ctx.arc(-11,5.7,3.9,0,Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(11, 5.7,3.9,0,Math.PI*2); ctx.fill();
    ctx.fillStyle = '#f0dcc8';
    ctx.beginPath(); ctx.arc(-11,7.5,3,0,Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(11, 7.5,3,0,Math.PI*2); ctx.fill();

    // ── DRESS (trapezoid — exact game shape) ──
    glow('#eeeeff', 8); ctx.fillStyle = '#f8f7f4';
    ctx.beginPath();
    ctx.moveTo(-7,-3); ctx.lineTo(-15,18); ctx.lineTo(15,18); ctx.lineTo(7,-3);
    ctx.closePath(); ctx.fill();
    noGlow();
    ctx.fillStyle = 'rgba(180,175,200,0.22)';
    ctx.beginPath();
    ctx.moveTo(-7,-3); ctx.lineTo(-15,18); ctx.lineTo(-5,18); ctx.lineTo(-1,-3);
    ctx.closePath(); ctx.fill();
    // Sleeves
    ctx.fillStyle = '#f8f7f4';
    ctx.beginPath(); ctx.moveTo(-7.5,-0.5); ctx.lineTo(-13,8.5); ctx.lineTo(-10,7.5); ctx.lineTo(-8.5,3); ctx.closePath(); ctx.fill();
    ctx.beginPath(); ctx.moveTo(7.5,-0.5);  ctx.lineTo(13,8.5);  ctx.lineTo(10,7.5);  ctx.lineTo(8.5,3);  ctx.closePath(); ctx.fill();

    // ── FACE ──
    glow('#f0dcc8', 10); ctx.fillStyle = '#f0dcc8';
    ctx.beginPath(); ctx.arc(0,-11,9,0,Math.PI*2); ctx.fill(); noGlow();
    // Eyes — dark outer, green inner, arc shadow, highlight
    ctx.fillStyle = '#182418';
    ctx.beginPath(); ctx.arc(-4,-11,2.8,0,Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc( 4,-11,2.8,0,Math.PI*2); ctx.fill();
    ctx.fillStyle = '#44cc44';
    ctx.beginPath(); ctx.arc(-4,-11,2.0,0,Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc( 4,-11,2.0,0,Math.PI*2); ctx.fill();
    ctx.fillStyle = 'rgba(0,40,0,0.28)';
    ctx.beginPath(); ctx.arc(-4,-10.4,1.8,0.1*Math.PI,0.9*Math.PI); ctx.fill();
    ctx.beginPath(); ctx.arc( 4,-10.4,1.8,0.1*Math.PI,0.9*Math.PI); ctx.fill();
    ctx.fillStyle = 'rgba(255,255,255,0.85)';
    ctx.beginPath(); ctx.arc(-4.8,-11.8,0.8,0,Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc( 3.2,-11.8,0.8,0,Math.PI*2); ctx.fill();
    // Nose
    ctx.fillStyle = 'rgba(140,90,40,0.35)';
    ctx.beginPath(); ctx.arc(-1.1,-8,0.9,0,Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc( 1.1,-8,0.9,0,Math.PI*2); ctx.fill();

    // ── L2 BANGS — both sides (exact game: draw normal + X-mirrored) ──
    glow('#ff2222', 5); ctx.fillStyle = '#ee2222';
    ctx.beginPath(); crPath(_L2); ctx.closePath(); ctx.fill();
    ctx.beginPath(); crPath(_L2.map(([x,y])=>[-x,y])); ctx.closePath(); ctx.fill();
    noGlow();

    // ── STRANDS ──
    glow('#cc1111', 4); ctx.strokeStyle = '#cc2222'; ctx.lineWidth = 0.7; ctx.lineCap = 'round';
    ctx.beginPath(); ctx.moveTo(1,-22.2);  ctx.quadraticCurveTo(-5.3,-13, 25.5,-7);  ctx.stroke();
    ctx.beginPath(); ctx.moveTo(-1,-22.2); ctx.quadraticCurveTo( 5.3,-13,-25.5,-7); ctx.stroke();
    noGlow();

    ctx.restore();
  }

  /* ─── Character dispatcher ─────────────────────────────────────────── */
  function drawExpCharacter(exp, alpha, ts) {
    if (!exp?.hasCharacter) return;
    if (exp.id === 'lailas-descent')    drawLaila(alpha, ts);
    else if (exp.id === 'drive-that-truck') drawTruckScene(alpha, ts);
  }

  /* ─── Truck + Noam sprite ───────────────────────────────────────────── */
  function drawTruckScene(alpha, ts) {
    if (alpha <= 0.01) return;

    const s    = R / 58;                        // 1 game unit = R/58 CSS px
    const bobY = Math.sin(ts * 0.0008) * 3;    // gentle vertical float
    const groundY = CY + R * 0.40;             // matches drawTruckBg groundY

    // Truck top-left in orb space — centered slightly left like the game
    const tx = CX - 32 * s;
    const ty = groundY - 28 * s + bobY;

    ctx.save();
    ctx.globalAlpha = alpha;
    ctx.translate(tx, ty);
    ctx.scale(s, s);
    // From here: game units relative to (0,0) = truck top-left. TRUCK_H=28.

    // ── CHIMNEY ──
    ctx.fillStyle = '#3a2418'; ctx.fillRect(9, -7, 3, 8);
    ctx.fillStyle = '#1a1828'; ctx.fillRect(8, -8, 5, 1);
    // static smoke — 3 puffs
    ctx.fillStyle = '#7a6a90';
    ctx.fillRect(7, -9, 5, 2);   ctx.fillRect(8,  -10, 3, 1);
    ctx.fillRect(4, -11, 6, 2);  ctx.fillRect(5,  -12, 4, 1);
    ctx.fillRect(2, -13, 7, 2);  ctx.fillRect(3,  -14, 5, 1);
    ctx.fillStyle = '#9c8cb0';
    ctx.fillRect(8, -9, 1, 1);   ctx.fillRect(5,  -11, 1, 1);

    // ── BODY (lavender silhouette) ──
    ctx.fillStyle = '#8a86a4';
    ctx.fillRect(1, 2, 36, 21); ctx.fillRect(37, 8, 21, 15); ctx.fillRect(50, 13, 8, 10);
    ctx.fillStyle = '#a8a4c0'; // top highlights
    ctx.fillRect(2, 2, 34, 1); ctx.fillRect(38, 9, 11, 1);
    ctx.fillStyle = '#5a566a'; // bottom shadow
    ctx.fillRect(1, 20, 36, 3); ctx.fillRect(37, 20, 21, 3);

    // ── CAGE INTERIOR + BARS ──
    ctx.fillStyle = '#1c1a2e'; ctx.fillRect(3, 5, 32, 16);
    ctx.fillStyle = '#0a0814';
    for (let i = 0; i < 6; i++) ctx.fillRect(4 + i*6, 5, 1, 16);
    ctx.fillRect(3, 5, 32, 1); ctx.fillRect(3, 20, 32, 1);

    // ── COW EYES (all 5, full health) ──
    const cs = [{x:5,y:8},{x:14,y:8},{x:23,y:8},{x:9,y:15},{x:19,y:15}];
    cs.forEach(sl => {
      ctx.fillStyle = '#e8e0d4';
      ctx.fillRect(sl.x, sl.y, 2, 2); ctx.fillRect(sl.x+3, sl.y, 2, 2);
      ctx.fillStyle = '#0a0814';
      ctx.fillRect(sl.x+1, sl.y+1, 1, 1); ctx.fillRect(sl.x+4, sl.y+1, 1, 1);
    });

    // ── CAB DETAILS ──
    ctx.fillStyle = '#1c1a2e'; ctx.fillRect(39, 10, 9, 6); // window void
    ctx.fillStyle = '#1a1828';
    ctx.fillRect(39, 9, 9, 1); ctx.fillRect(39, 16, 10, 1); // window frame
    ctx.fillStyle = '#5a566a'; ctx.fillRect(37, 8, 1, 15);  // cab back edge
    ctx.fillStyle = '#f5d8a0'; ctx.fillRect(56, 18, 2, 2);  // headlight

    // ── CHASSIS + WHEEL ARCHES ──
    ctx.fillStyle = '#1a1828';
    ctx.fillRect(0, 23, 58, 1);
    ctx.fillRect(5, 22, 8, 2); ctx.fillRect(19, 22, 8, 2); ctx.fillRect(44, 22, 9, 2);

    // ── NOAM IN CAB — drawNoamHead(40, 4) ──
    // Hair tuft (3 prongs above cab roof)
    ctx.fillStyle = '#e07840';
    ctx.fillRect(42, 4, 1, 1); ctx.fillRect(44, 3, 1, 1);
    ctx.fillRect(44, 4, 1, 1); ctx.fillRect(46, 4, 1, 1);
    ctx.fillRect(41, 5, 8, 2);
    ctx.fillStyle = '#a04820'; ctx.fillRect(41, 7, 8, 1);
    // Face
    ctx.fillStyle = '#eab68a';
    ctx.fillRect(41, 8, 8, 8); ctx.fillRect(40, 9, 1, 6); ctx.fillRect(49, 9, 1, 6);
    ctx.fillRect(42, 16, 6, 1);
    ctx.fillStyle = '#b88068';
    ctx.fillRect(48, 9, 1, 7); ctx.fillRect(42, 15, 6, 1);
    // Eyes
    ctx.fillStyle = '#f8f4e8';
    ctx.fillRect(41, 9, 3, 3); ctx.fillRect(46, 9, 3, 3);
    ctx.fillStyle = '#0a0612';
    ctx.fillRect(42, 10, 1, 1); ctx.fillRect(47, 10, 1, 1);
    // Eye rims
    ctx.fillRect(41,9,1,1); ctx.fillRect(43,9,1,1); ctx.fillRect(41,11,1,1); ctx.fillRect(43,11,1,1);
    ctx.fillRect(46,9,1,1); ctx.fillRect(48,9,1,1); ctx.fillRect(46,11,1,1); ctx.fillRect(48,11,1,1);
    // Mouth + tongue
    ctx.fillStyle = '#7a2018'; ctx.fillRect(43, 13, 4, 3);
    ctx.fillStyle = '#e05858'; ctx.fillRect(44, 14, 2, 1);

    // ── WHEELS ──
    [[9,26],[23,26],[49,26]].forEach(([cx,cy]) => {
      ctx.fillStyle = '#0a0814';
      ctx.fillRect(cx-3, cy-3, 7, 6);
      ctx.fillRect(cx-4, cy-2, 1, 4); ctx.fillRect(cx+4, cy-2, 1, 4);
      ctx.fillRect(cx-2, cy-4, 5, 1); ctx.fillRect(cx-2, cy+3, 5, 1);
      ctx.fillStyle = '#5a566a'; ctx.fillRect(cx, cy-1, 2, 2); // hub
    });

    ctx.restore();
  }

  /* ─── DOM show/hide ────────────────────────────────────────────────── */
  function showReveal(exp) {
    const rc = `rgb(${exp.swirlR},${exp.swirlG},${exp.swirlB})`;
    revPanel.style.setProperty('--reveal-color', rc);
    revEye.textContent   = exp.eyebrow;
    revTitle.textContent = exp.title;
    // Shrink font until title fits on one line
    revTitle.style.fontSize = '2.4rem';
    while (revTitle.scrollWidth > revTitle.offsetWidth && parseFloat(revTitle.style.fontSize) > 0.5) {
      revTitle.style.fontSize = (parseFloat(revTitle.style.fontSize) - 0.05) + 'rem';
    }

    if (exp.url) {
      btnReshuffle.removeAttribute('aria-hidden');
    } else {
      btnReshuffle.setAttribute('aria-hidden', 'true');
    }

    // Aurora rim shifts to experience colour — still diffuse, no hard outline
    rim.style.boxShadow = `
      0 0 55px 20px rgba(${exp.swirlR},${exp.swirlG},${exp.swirlB},0.24),
      0 0 100px 36px rgba(${exp.swirlR},${exp.swirlG},${exp.swirlB},0.13),
      0 0 160px 55px rgba(${exp.swirlR},${exp.swirlG},${exp.swirlB},0.06)
    `;
    revPanel.setAttribute('aria-hidden', 'false');

    if (exp.id === 'secret') {
      secretTimer = setTimeout(() => {
        if (state === 'revealed' && currentExp?.id === 'secret') resetToIdle();
      }, 7000);
    }
  }

  function resetToIdle() {
    clearTimeout(secretTimer);
    state      = 'idle';
    revAlpha   = 0;
    bgAlpha    = 0;
    shineAlpha = 0;
    currentExp = null;
    swirlParts = [];
    rim.style.boxShadow = '';
    revPanel.setAttribute('aria-hidden', 'true');
    btnReshuffle.setAttribute('aria-hidden', 'true');
  }

  /* ─── Press handler ────────────────────────────────────────────────── */
  function handlePress() {
    if (state === 'swirling' || state === 'shining') return;

    if (state === 'idle') {
      currentExp = pickExp(null);
      spawnSwirl('inward', [currentExp.swirlR, currentExp.swirlG, currentExp.swirlB]);
      swirlDir = 'inward'; swirlDur = 960;
      swirlStart = performance.now();
      revAlpha = 0;
      state = 'swirling';

    } else if (state === 'revealed') {
      if (currentExp.url) {
        // Playable game — shine then launch
        state = 'shining';
        shineStart = performance.now();
      } else {
        // Not playable — reshuffle
        doReshuffle();
      }
    }
  }

  function doReshuffle() {
    if (state !== 'revealed') return;
    clearTimeout(secretTimer);
    pendingExp = pickExp(currentExp);
    spawnSwirl('outward', [currentExp.swirlR, currentExp.swirlG, currentExp.swirlB], 70);
    swirlDir = 'outward'; swirlDur = 500;
    swirlStart = performance.now();
    state = 'swirling';
    revPanel.setAttribute('aria-hidden', 'true');
    btnReshuffle.setAttribute('aria-hidden', 'true');
    btnReshuffle.setAttribute('aria-hidden', 'true');
  }

  function pickExp(exclude) {
    const pool  = experiences.filter(e => !exclude || e.id !== exclude.id);
    const total = pool.reduce((s, e) => s + e.weight, 0);
    let   roll  = Math.random() * total;
    for (const e of pool) { roll -= e.weight; if (roll <= 0) return e; }
    return pool[pool.length - 1];
  }

  /* ─── Render loop ───────────────────────────────────────────────────── */
  let rafId;
  function render(ts) {
    ctx.clearRect(0, 0, W, H);

    ctx.save();
    ctx.beginPath();
    ctx.arc(CX, CY, R, 0, Math.PI * 2);
    ctx.clip();

    // ── Background crossfade ──
    if (state === 'swirling') {
      const elapsed = ts - swirlStart;
      bgAlpha = swirlDir === 'inward'
        ? Math.min(elapsed / swirlDur, 1)
        : Math.max(1 - elapsed / swirlDur, 0);
    } else if (state === 'revealed') {
      bgAlpha = 1;
    } else {
      bgAlpha = 0;
    }

    drawNeutralBg(1 - bgAlpha);
    if (bgAlpha > 0.01 && currentExp) drawExpBg(currentExp, bgAlpha, ts);

    // ── Swirl & character ──
    if (state === 'swirling') {
      const elapsed = ts - swirlStart;
      const prog    = elapsed / swirlDur;

      drawSwirl(elapsed);

      if (swirlDir === 'inward') {
        if (elapsed > swirlDur * 0.62 && currentExp?.hasCharacter) {
          revAlpha = Math.min((elapsed - swirlDur*0.62) / (swirlDur*0.45), 1);
          drawExpCharacter(currentExp, revAlpha, ts);
        }
        if (prog >= 1) {
          state = 'revealed'; revAlpha = 1; swirlParts = [];
          showReveal(currentExp);
        }
      } else {
        revAlpha = Math.max(1 - elapsed / (swirlDur * 0.65), 0);
        drawExpCharacter(currentExp, revAlpha, ts);
        if (prog >= 1) {
          currentExp = pendingExp;
          spawnSwirl('inward', [currentExp.swirlR, currentExp.swirlG, currentExp.swirlB]);
          swirlDir = 'inward'; swirlDur = 960; swirlStart = ts; revAlpha = 0;
        }
      }
    }

    if (state === 'shining') {
      const elapsed = ts - shineStart;
      shineAlpha = Math.min(Math.pow(elapsed / shineDur, 0.65), 1);

      // Draw experience background at full opacity
      if (currentExp) drawExpBg(currentExp, 1, ts);

      // Character as dark silhouette — brightness filter dims to near-black
      if (currentExp?.hasCharacter) {
        ctx.save();
        try {
          const br  = (1 - shineAlpha * 0.98).toFixed(3);
          const sat = Math.max(0, 1 - shineAlpha * 1.6).toFixed(2);
          ctx.filter = `brightness(${br}) saturate(${sat}) contrast(1.4)`;
        } catch(e) {}
        drawExpCharacter(currentExp, 1, ts);
        ctx.restore();
      }

      // Bright radial flash — warm white/gold from center
      const flash = ctx.createRadialGradient(CX, CY, 0, CX, CY, R);
      flash.addColorStop(0,    `rgba(255,248,220,${shineAlpha})`);
      flash.addColorStop(0.45, `rgba(255,230,140,${shineAlpha * 0.88})`);
      flash.addColorStop(0.8,  `rgba(255,200,80,${shineAlpha * 0.45})`);
      flash.addColorStop(1,    `rgba(255,170,40,${shineAlpha * 0.08})`);
      ctx.fillStyle = flash;
      ctx.fillRect(0, 0, W, H);

      // Rim blazes to warm white
      rim.style.boxShadow = `
        0 0 90px 40px rgba(255,240,180,${shineAlpha * 0.75}),
        0 0 160px 70px rgba(255,210,100,${shineAlpha * 0.40}),
        0 0 220px 90px rgba(255,180,50,${shineAlpha * 0.15})
      `;

      if (elapsed >= shineDur) window.location.href = currentExp.url;
    }

    if (state === 'revealed') {
      drawExpCharacter(currentExp, revAlpha, ts);
      // Ambient glitter shimmer in revealed state
      if (Math.random() < 0.018) {
        const [sr, sg, sb] = [currentExp.swirlR, currentExp.swirlG, currentExp.swirlB];
        for (let i = 0; i < 4; i++) {
          const a = Math.random() * Math.PI * 2;
          const r = R * (0.25 + Math.random() * 0.58);
          ctx.beginPath();
          ctx.arc(CX + Math.cos(a)*r, CY + Math.sin(a)*r, 0.8 + Math.random()*1.2, 0, Math.PI*2);
          ctx.fillStyle = `rgba(${sr},${sg},${sb},${0.28 + Math.random()*0.45})`;
          ctx.fill();
        }
      }
    }

    ctx.restore();
    rafId = requestAnimationFrame(render);
  }

  rafId = requestAnimationFrame(render);

  wrap.addEventListener('click', handlePress);
  wrap.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); handlePress(); }
  });
  btnReshuffle.addEventListener('click', doReshuffle);
  document.addEventListener('astro:before-swap', () => cancelAnimationFrame(rafId));
})();
</script>
