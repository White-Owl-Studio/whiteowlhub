---
import Base from '../layouts/Base.astro';

const experiences = [
  {
    id: 'lailas-descent',
    title: "Laila's Descent",
    tagline: "She came looking for the exit. There isn't one.",
    eyebrow: 'Horror Shooter',
    status: 'demo',
    url: '/experiences/lailas-descent',
    weight: 0.50,
    swirlR: 238, swirlG: 34,  swirlB: 34,
    hasCharacter: true,
  },
  {
    id: 'placeholder-a',
    title: '[Untitled Experience]',
    tagline: 'Something is being assembled beneath this surface.',
    eyebrow: 'Coming Soon',
    status: 'conjuring',
    url: null,
    weight: 0.24,
    swirlR: 120, swirlG: 224, swirlB: 88,
    hasCharacter: false,
  },
  {
    id: 'placeholder-b',
    title: '[No Name Yet]',
    tagline: 'Not ready. Possibly not safe.',
    eyebrow: 'Coming Soon',
    status: 'conjuring',
    url: null,
    weight: 0.24,
    swirlR: 112, swirlG: 64,  swirlB: 184,
    hasCharacter: false,
  },
  {
    id: 'secret',
    title: '⊹  ⊹  ⊹',
    tagline: "You found something that doesn't have a name yet. Check back.",
    eyebrow: '',
    status: 'unknown',
    url: null,
    weight: 0.02,
    swirlR: 245, swirlG: 208, swirlB: 96,
    hasCharacter: false,
  },
];
---

<Base title="Online Playthings" description="Interactive experiences from White Owl Studio. Gaze into the water.">

  <section class="xp-hero">

    <header class="xp-header">
      <p class="eyebrow">Online Playthings</p>
      <p class="xp-tagline">
        This lake holds things.<br/>
        <em>Most of them are interactive.</em>
      </p>
    </header>

    <div class="orb-stage">

      <!-- The orb — canvas + CSS rim, acts as a button -->
      <button
        class="orb-wrap"
        id="orb-wrap"
        type="button"
        aria-label="Press to reveal an experience from White Owl Studio"
      >
        <canvas id="orb-canvas" aria-hidden="true"></canvas>
        <div class="orb-rim" id="orb-rim" aria-hidden="true"></div>
      </button>

      <!-- Text panel — prompt and reveal share same grid cell -->
      <div class="orb-text-area">

        <div class="orb-prompt" id="orb-prompt">
          <p class="prompt-main">Gaze into the water.</p>
          <p class="prompt-sub">Press to see what stirs.</p>
        </div>

        <div class="orb-reveal" id="orb-reveal" aria-hidden="true">
          <p class="reveal-eyebrow" id="reveal-eyebrow"></p>
          <h2 class="reveal-title"  id="reveal-title"></h2>
          <p class="reveal-tagline" id="reveal-tagline"></p>
          <div class="reveal-actions">
            <a  class="btn-enter" id="btn-enter" href="#">Enter</a>
            <button class="btn-again" id="btn-again" type="button">Press again ↺</button>
          </div>
        </div>

      </div>

    </div>

  </section>

</Base>

<style>
  /* ════════════ PAGE ════════════ */
  .xp-hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--section-py) var(--section-px);
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .xp-header { text-align: center; }

  .eyebrow {
    font-family: 'Cinzel', serif;
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--accent-experiences);
    margin-bottom: 0.85rem;
    opacity: 0.85;
  }

  .xp-tagline {
    font-family: 'Crimson Pro', serif;
    font-size: clamp(1rem, 2.2vw, 1.3rem);
    color: var(--text-muted);
    line-height: 1.65;
    text-align: center;
  }
  .xp-tagline em { color: var(--text); font-style: italic; }

  /* ════════════ ORB STAGE ════════════ */
  .orb-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  /* ════════════ THE ORB ════════════ */
  .orb-wrap {
    --orb-size: clamp(280px, 50vmin, 520px);
    position: relative;
    width: var(--orb-size);
    height: var(--orb-size);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    border-radius: 50%;
    outline: none;
    flex-shrink: 0;
  }
  .orb-wrap:focus-visible {
    box-shadow: 0 0 0 3px var(--accent-experiences);
  }

  #orb-canvas {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }

  /* CSS rim — reflects experience accent color via JS */
  .orb-rim {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
    transition: box-shadow 0.6s ease;
    box-shadow:
      0 0 0 1px rgba(120,224,88,0.1),
      0 0 48px rgba(120,224,88,0.06),
      inset 0 0 32px rgba(5,4,9,0.5);
  }
  .orb-wrap:hover .orb-rim {
    box-shadow:
      0 0 0 1px rgba(120,224,88,0.22),
      0 0 72px rgba(120,224,88,0.12),
      inset 0 0 20px rgba(5,4,9,0.3);
  }

  /* ════════════ TEXT PANELS ════════════ */
  .orb-text-area {
    display: grid;
    grid-template-areas: 'panel';
    min-height: 140px;
    align-items: center;
    justify-items: center;
    width: 100%;
    max-width: 500px;
  }

  .orb-prompt,
  .orb-reveal {
    grid-area: panel;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    text-align: center;
    transition: opacity 0.4s ease;
  }

  /* ── Prompt ── */
  .prompt-main {
    font-family: 'Cinzel', serif;
    font-size: clamp(0.75rem, 1.6vw, 0.95rem);
    letter-spacing: 0.15em;
    color: var(--text-muted);
  }
  .prompt-sub {
    font-family: 'Crimson Pro', serif;
    font-style: italic;
    font-size: clamp(0.88rem, 1.8vw, 1.05rem);
    color: var(--text-muted);
    opacity: 0.55;
  }

  /* ── Reveal panel ── */
  .orb-reveal[aria-hidden='true']  { opacity: 0; pointer-events: none; }
  .orb-reveal[aria-hidden='false'] { opacity: 1; }

  .reveal-eyebrow {
    font-family: 'Cinzel', serif;
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--reveal-color, var(--accent-experiences));
    opacity: 0.75;
    min-height: 1em;
  }

  .reveal-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.4rem, 4vw, 2.4rem);
    font-weight: 400;
    color: var(--text);
    letter-spacing: 0.04em;
    line-height: 1.15;
    text-shadow: 0 0 32px var(--reveal-color, transparent);
  }

  .reveal-tagline {
    font-family: 'Crimson Pro', serif;
    font-style: italic;
    font-size: clamp(0.9rem, 1.8vw, 1.1rem);
    color: var(--text-muted);
    max-width: 380px;
    line-height: 1.55;
  }

  .reveal-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 0.6rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-enter {
    font-family: 'Cinzel', serif;
    font-size: 0.62rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--reveal-color, var(--accent-experiences));
    border: 1px solid var(--reveal-color, var(--accent-experiences));
    padding: 0.6rem 1.75rem;
    text-decoration: none;
    transition: background 0.22s, color 0.22s;
    display: inline-block;
  }
  .btn-enter:hover {
    background: var(--reveal-color, var(--accent-experiences));
    color: var(--bg);
  }
  .btn-enter[aria-hidden='true'] { display: none; }

  .btn-again {
    font-family: 'Cinzel', serif;
    font-size: 0.56rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.4rem;
    opacity: 0.55;
    transition: opacity 0.2s, color 0.2s;
  }
  .btn-again:hover { opacity: 1; color: var(--text); }

  /* ── Mobile ── */
  @media (max-width: 480px) {
    .xp-hero { justify-content: flex-start; padding-top: clamp(80px, 15vw, 120px); }
  }
</style>

<script define:vars={{ experiences }}>
(function () {
  /* ─── DOM ─────────────────────────────────────────────────────────── */
  const wrap      = document.getElementById('orb-wrap');
  const canvas    = document.getElementById('orb-canvas');
  const rim       = document.getElementById('orb-rim');
  const prompt    = document.getElementById('orb-prompt');
  const revPanel  = document.getElementById('orb-reveal');
  const revEye    = document.getElementById('reveal-eyebrow');
  const revTitle  = document.getElementById('reveal-title');
  const revTag    = document.getElementById('reveal-tagline');
  const btnEnter  = document.getElementById('btn-enter');
  const btnAgain  = document.getElementById('btn-again');
  if (!canvas || !wrap) return;

  /* ─── Canvas init ─────────────────────────────────────────────────── */
  const dpr  = Math.min(window.devicePixelRatio || 1, 2);
  const CSS  = wrap.clientWidth;
  canvas.width  = CSS * dpr;
  canvas.height = CSS * dpr;
  const ctx  = canvas.getContext('2d');
  ctx.scale(dpr, dpr);
  const W = CSS, H = CSS, CX = W / 2, CY = H / 2, R = W * 0.48;

  /* ─── State ───────────────────────────────────────────────────────── */
  let state       = 'idle';    // 'idle' | 'swirling' | 'revealed'
  let currentExp  = null;
  let pendingExp  = null;
  let revAlpha    = 0;
  let swirlParts  = [];
  let swirlStart  = 0;
  let swirlDir    = 'inward';  // 'inward' | 'outward'
  let swirlDur    = 960;
  let swirlCol    = [120, 224, 88];
  let secretTimer = null;

  /* ─── Idle lake particles (sediment drifts upward — disorienting) ── */
  const lakeParts = Array.from({ length: 30 }, () => ({
    x:  CX + (Math.random() - 0.5) * R * 1.7,
    y:  CY + (Math.random() * 2 - 0.5) * R,
    vy: -(0.08 + Math.random() * 0.22),
    vx: (Math.random() - 0.5) * 0.06,
    sz: 0.5 + Math.random() * 1.6,
    op: 0.08 + Math.random() * 0.22,
  }));

  /* ─── Weighted experience picker ─────────────────────────────────── */
  function pickExp(exclude) {
    const pool  = experiences.filter(e => !exclude || e.id !== exclude.id);
    const total = pool.reduce((s, e) => s + e.weight, 0);
    let   roll  = Math.random() * total;
    for (const e of pool) {
      roll -= e.weight;
      if (roll <= 0) return e;
    }
    return pool[pool.length - 1];
  }

  /* ─── Swirl particle spawner ─────────────────────────────────────── */
  function spawnSwirl(dir, col, n = 92) {
    swirlParts = [];
    swirlCol   = col;
    for (let i = 0; i < n; i++) {
      const ang    = Math.random() * Math.PI * 2;
      const startR = dir === 'inward'
        ? R * (0.80 + Math.random() * 0.18)
        : R * (0.01 + Math.random() * 0.06);
      const endR = dir === 'inward'
        ? R * (0.01 + Math.random() * 0.05)
        : R * (0.78 + Math.random() * 0.20);
      swirlParts.push({
        ang, startR, endR, curR: startR,
        dAng: (dir === 'inward' ? 1 : -1) * (0.018 + Math.random() * 0.04),
        sz:   0.7 + Math.random() * 2.4,
        op:   0.35 + Math.random() * 0.60,
      });
    }
  }

  /* ─── DOM: show / hide panels ────────────────────────────────────── */
  function showReveal(exp) {
    const rc = `rgb(${exp.swirlR},${exp.swirlG},${exp.swirlB})`;
    revPanel.style.setProperty('--reveal-color', rc);
    revEye.textContent  = exp.eyebrow;
    revTitle.textContent  = exp.title;
    revTag.textContent  = exp.tagline;

    if (exp.url) {
      btnEnter.href = exp.url;
      btnEnter.removeAttribute('aria-hidden');
    } else {
      btnEnter.setAttribute('aria-hidden', 'true');
    }

    rim.style.boxShadow = `
      0 0 0 1px rgba(${exp.swirlR},${exp.swirlG},${exp.swirlB},0.28),
      0 0 72px rgba(${exp.swirlR},${exp.swirlG},${exp.swirlB},0.12),
      inset 0 0 20px rgba(5,4,9,0.3)
    `;
    prompt.style.opacity         = '0';
    prompt.style.pointerEvents   = 'none';
    revPanel.setAttribute('aria-hidden', 'false');

    if (exp.id === 'secret') {
      secretTimer = setTimeout(() => {
        if (state === 'revealed' && currentExp?.id === 'secret') resetToIdle();
      }, 7000);
    }
  }

  function resetToIdle() {
    clearTimeout(secretTimer);
    state      = 'idle';
    revAlpha   = 0;
    currentExp = null;
    swirlParts = [];
    prompt.style.opacity       = '';
    prompt.style.pointerEvents = '';
    rim.style.boxShadow        = '';
    revPanel.setAttribute('aria-hidden', 'true');
  }

  /* ─── Press handler ──────────────────────────────────────────────── */
  function handlePress() {
    if (state === 'swirling') return;

    if (state === 'idle') {
      currentExp = pickExp(null);
      spawnSwirl('inward', [currentExp.swirlR, currentExp.swirlG, currentExp.swirlB]);
      swirlDir = 'inward';
      swirlDur = 960;
      swirlStart = performance.now();
      revAlpha = 0;
      state = 'swirling';

    } else if (state === 'revealed') {
      pendingExp = pickExp(currentExp);
      spawnSwirl('outward', [currentExp.swirlR, currentExp.swirlG, currentExp.swirlB], 70);
      swirlDir = 'outward';
      swirlDur = 500;
      swirlStart = performance.now();
      state = 'swirling';
      revPanel.setAttribute('aria-hidden', 'true');
    }
  }

  /* ─── Canvas drawing helpers ─────────────────────────────────────── */
  function drawLake(ts) {
    // Radial gradient — dark cold lake
    const g = ctx.createRadialGradient(CX, CY - R*0.1, 0, CX, CY, R);
    g.addColorStop(0,   '#0d2040');
    g.addColorStop(0.5, '#07111f');
    g.addColorStop(1,   '#040910');
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, W, H);

    // Cold shimmer from above — Zone 1's silver-blue light
    const pulse = 0.5 + 0.5 * Math.sin(ts * 0.00042);
    const lg = ctx.createRadialGradient(CX, CY - R*0.7, 0, CX, CY - R*0.45, R * 0.55);
    lg.addColorStop(0, `rgba(184,212,240,${0.09 * pulse})`);
    lg.addColorStop(1, 'rgba(184,212,240,0)');
    ctx.fillStyle = lg;
    ctx.fillRect(0, 0, W, H);
  }

  function drawLakeParticles() {
    lakeParts.forEach(p => {
      p.y += p.vy;
      p.x += p.vx;
      // Wrap when reaching the top of the orb
      if (p.y < CY - R * 0.9) {
        p.y = CY + R * 0.82;
        p.x = CX + (Math.random() - 0.5) * R * 1.5;
      }
      // Stay within circle
      const dx = p.x - CX, dy = p.y - CY;
      if (dx * dx + dy * dy > R * R * 0.88) {
        p.x = CX + (Math.random() - 0.5) * R;
        p.y = CY + Math.random() * R * 0.7;
      }
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.sz, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(184,212,240,${p.op})`;
      ctx.fill();
    });
  }

  function drawSwirl(elapsed) {
    if (!swirlParts.length) return;
    const prog = Math.min(elapsed / swirlDur, 1);
    const ease = swirlDir === 'inward'
      ? 1 - Math.pow(1 - prog, 2.8)
      : Math.pow(prog, 1.8);
    const [sr, sg, sb] = swirlCol;

    swirlParts.forEach(p => {
      p.ang  += p.dAng;
      p.curR  = p.startR + (p.endR - p.startR) * ease;
      const fadeOp = p.op * (1 - Math.pow(prog, 1.6));
      if (fadeOp < 0.02) return;

      const px = CX + Math.cos(p.ang) * p.curR;
      const py = CY + Math.sin(p.ang) * p.curR;

      // Halo glow
      ctx.save();
      ctx.globalAlpha = fadeOp * 0.3;
      ctx.beginPath();
      ctx.arc(px, py, p.sz * 3.2, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${sr},${sg},${sb},0.5)`;
      ctx.fill();
      ctx.restore();

      // Core spark
      ctx.beginPath();
      ctx.arc(px, py, p.sz, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${sr},${sg},${sb},${fadeOp})`;
      ctx.fill();
    });
  }

  /* ─── Laila sprite ────────────────────────────────────────────────── */
  function drawLaila(alpha, ts) {
    if (alpha <= 0.01) return;
    const float = Math.sin(ts * 0.00085) * (R * 0.022);
    const ox = CX, oy = CY - R * 0.06 + float;
    const s  = (R * 0.58) / 83;   // 83 = Laila unit-height

    ctx.save();
    ctx.globalAlpha = alpha;

    // Subtle red glow behind her
    const glow = ctx.createRadialGradient(ox, oy, 0, ox, oy, R * 0.48);
    glow.addColorStop(0, 'rgba(238,34,34,0.10)');
    glow.addColorStop(1, 'rgba(238,34,34,0)');
    ctx.fillStyle = glow;
    ctx.beginPath();
    ctx.arc(ox, oy, R * 0.48, 0, Math.PI * 2);
    ctx.fill();

    // ── Dress ──
    ctx.beginPath();
    ctx.moveTo(ox - 11*s, oy - 6*s);
    ctx.bezierCurveTo(ox - 20*s, oy + 18*s, ox - 16*s, oy + 44*s, ox - 7*s, oy + 58*s);
    ctx.lineTo(ox + 7*s, oy + 58*s);
    ctx.bezierCurveTo(ox + 16*s, oy + 44*s, ox + 20*s, oy + 18*s, ox + 11*s, oy - 6*s);
    ctx.closePath();
    ctx.fillStyle = 'rgba(252,250,243,0.90)';
    ctx.fill();
    // Soft centre crease
    ctx.beginPath();
    ctx.moveTo(ox - 2*s, oy - 4*s);
    ctx.bezierCurveTo(ox - 2*s, oy + 20*s, ox - 1*s, oy + 42*s, ox - 1*s, oy + 58*s);
    ctx.strokeStyle = 'rgba(200,195,178,0.22)';
    ctx.lineWidth = 1.5 * s;
    ctx.stroke();

    // ── Arms (outstretched — falling pose) ──
    ctx.lineWidth  = 5.5 * s;
    ctx.lineCap    = 'round';
    ctx.strokeStyle = 'rgba(248,228,206,0.86)';
    ctx.beginPath();
    ctx.moveTo(ox - 11*s, oy + 4*s);
    ctx.bezierCurveTo(ox - 26*s, oy + 1*s, ox - 38*s, oy - 7*s, ox - 43*s, oy - 4*s);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(ox + 11*s, oy + 4*s);
    ctx.bezierCurveTo(ox + 26*s, oy + 1*s, ox + 38*s, oy - 7*s, ox + 43*s, oy - 4*s);
    ctx.stroke();

    // ── Head ──
    ctx.beginPath();
    ctx.arc(ox, oy - 18*s, 13*s, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(248,228,208,0.95)';
    ctx.fill();

    // ── Hair L1 (back layer — approved coords) ──
    // neckR(4,-4.3) earR(17.8,-8.5) wingR(25.5,-19.1) tipR(17.8,-18.1) topR(6,-24.9) crown(0,-23.6)
    ctx.beginPath();
    ctx.moveTo(ox + 4*s, oy - 4.3*s);
    ctx.bezierCurveTo(
      ox + 17.8*s, oy - 8.5*s,
      ox + 25.5*s, oy - 19.1*s,
      ox + 17.8*s, oy - 18.1*s
    );
    ctx.bezierCurveTo(
      ox + 11*s,   oy - 17*s,
      ox + 6*s,    oy - 24.9*s,
      ox,          oy - 23.6*s
    );
    ctx.bezierCurveTo(
      ox - 9*s,    oy - 22*s,
      ox - 11*s,   oy - 11*s,
      ox - 5*s,    oy - 4.3*s
    );
    ctx.closePath();
    ctx.fillStyle = '#ee2222';
    ctx.fill();

    // ── Hair L2 (front bangs — approved coords) ──
    // rOuter(11.8,-10.6) rTop(5,-22) rInner(0,-17.8) rBot(5,-13)
    ctx.beginPath();
    ctx.moveTo(ox + 5*s,    oy - 13*s);
    ctx.bezierCurveTo(
      ox + 11.8*s, oy - 10.6*s,
      ox + 13*s,   oy - 16*s,
      ox + 5*s,    oy - 22*s
    );
    ctx.bezierCurveTo(
      ox + 1*s,    oy - 24.5*s,
      ox - 1*s,    oy - 17.8*s,
      ox + 2*s,    oy - 13*s
    );
    ctx.fillStyle = '#ee2222';
    ctx.fill();

    // ── Eyes (large, round — approved) ──
    const ey  = oy - 19*s;
    const er  = 4.5*s;
    ctx.beginPath(); ctx.arc(ox - 5*s, ey, er, 0, Math.PI * 2);
    ctx.fillStyle = '#33bb44'; ctx.fill();
    ctx.beginPath(); ctx.arc(ox + 5*s, ey, er, 0, Math.PI * 2);
    ctx.fillStyle = '#33bb44'; ctx.fill();
    // Pupils
    ctx.fillStyle = 'rgba(8,4,16,0.92)';
    ctx.beginPath(); ctx.arc(ox - 5*s, ey, 2.7*s, 0, Math.PI * 2); ctx.fill();
    ctx.beginPath(); ctx.arc(ox + 5*s, ey, 2.7*s, 0, Math.PI * 2); ctx.fill();
    // Highlights
    ctx.fillStyle = 'rgba(255,255,255,0.88)';
    ctx.beginPath(); ctx.arc(ox - 3.8*s, ey - 1.5*s, 1.2*s, 0, Math.PI * 2); ctx.fill();
    ctx.beginPath(); ctx.arc(ox + 6.2*s, ey - 1.5*s, 1.2*s, 0, Math.PI * 2); ctx.fill();

    ctx.restore();
  }

  /* ─── Render loop ─────────────────────────────────────────────────── */
  let rafId;
  function render(ts) {
    ctx.clearRect(0, 0, W, H);

    // Clip all drawing to the orb circle
    ctx.save();
    ctx.beginPath();
    ctx.arc(CX, CY, R, 0, Math.PI * 2);
    ctx.clip();

    drawLake(ts);
    drawLakeParticles();

    if (state === 'swirling') {
      const elapsed = ts - swirlStart;
      const prog    = elapsed / swirlDur;

      drawSwirl(elapsed);

      if (swirlDir === 'inward') {
        // Fade in Laila from 65% through the swirl
        if (elapsed > swirlDur * 0.62 && currentExp?.hasCharacter) {
          revAlpha = Math.min((elapsed - swirlDur * 0.62) / (swirlDur * 0.45), 1);
          drawLaila(revAlpha, ts);
        }
        if (prog >= 1) {
          state    = 'revealed';
          revAlpha = 1;
          swirlParts = [];
          showReveal(currentExp);
        }

      } else { // outward
        revAlpha = Math.max(1 - elapsed / (swirlDur * 0.65), 0);
        if (currentExp?.hasCharacter) drawLaila(revAlpha, ts);

        if (prog >= 1) {
          // Hand off to inward swirl for new experience
          currentExp = pendingExp;
          spawnSwirl('inward', [currentExp.swirlR, currentExp.swirlG, currentExp.swirlB]);
          swirlDir   = 'inward';
          swirlDur   = 960;
          swirlStart = ts;
          revAlpha   = 0;
        }
      }
    }

    if (state === 'revealed') {
      if (currentExp?.hasCharacter) drawLaila(revAlpha, ts);
      // Occasional ambient glitter once revealed
      if (Math.random() < 0.018) {
        const [sr, sg, sb] = [currentExp.swirlR, currentExp.swirlG, currentExp.swirlB];
        for (let i = 0; i < 4; i++) {
          const a = Math.random() * Math.PI * 2;
          const r = R * (0.3 + Math.random() * 0.55);
          ctx.beginPath();
          ctx.arc(CX + Math.cos(a)*r, CY + Math.sin(a)*r, 0.8 + Math.random() * 1.2, 0, Math.PI*2);
          ctx.fillStyle = `rgba(${sr},${sg},${sb},${0.3 + Math.random() * 0.45})`;
          ctx.fill();
        }
      }
    }

    ctx.restore(); // end orb clip

    rafId = requestAnimationFrame(render);
  }

  rafId = requestAnimationFrame(render);

  /* ─── Events ─────────────────────────────────────────────────────── */
  wrap.addEventListener('click', handlePress);
  wrap.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); handlePress(); }
  });
  btnAgain.addEventListener('click', e => { e.stopPropagation(); handlePress(); });

  // Cleanup on Astro page transitions
  document.addEventListener('astro:before-swap', () => cancelAnimationFrame(rafId));
})();
</script>
