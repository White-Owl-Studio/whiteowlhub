<script>
  /* ── Film filter ── */
  const tabs    = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
  const entries = document.querySelectorAll<HTMLElement>('.catalog-entry');
  const empty   = document.getElementById('filter-empty')!;

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const filter = tab.dataset.filter!;

      /* Update tab state */
      tabs.forEach(t => {
        t.classList.remove('filter-tab--active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('filter-tab--active');
      tab.setAttribute('aria-selected', 'true');

      /* Show/hide entries */
      let visible = 0;
      entries.forEach(entry => {
        const match = filter === 'all' || entry.dataset.film === filter;
        entry.classList.toggle('is-hidden', !match);
        if (match) visible++;
      });

      /* Empty state */
      empty.classList.toggle('is-visible', visible === 0);
      if (visible === 0) {
        empty.textContent = 'No items found for this selection — check back when the conjuring is complete.';
      }
    });
  });
</script>
