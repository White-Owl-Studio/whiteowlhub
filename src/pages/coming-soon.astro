---
// Standalone — no Base.astro, no nav, no footer
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>White Owl Studio</title>
  <meta name="description" content="Something new is growing here." />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/ui/logo.gif" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500&family=Crimson+Pro:ital,wght@0,300;1,300;1,400&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body { min-height: 100vh; background: #050409; color: #e4dac8; font-family: 'Crimson Pro', Georgia, serif; }

    .page {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: clamp(3rem, 8vw, 6rem) clamp(1.5rem, 6vw, 4rem);
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    #grain { position: fixed; inset: 0; pointer-events: none; z-index: 9999; }

    .inner { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; }

    .logo { width: clamp(56px, 10vw, 80px); height: auto; margin-bottom: 1rem; display: block; }

    .studio-name {
      font-family: 'Cinzel', serif;
      font-size: clamp(0.6rem, 1.2vw, 0.75rem);
      letter-spacing: 0.35em;
      text-transform: uppercase;
      color: #f5d060;
      opacity: 0.65;
      margin-bottom: clamp(3rem, 6vw, 5rem);
    }

    .message {
      font-family: 'Crimson Pro', serif;
      font-style: italic;
      font-weight: 300;
      font-size: clamp(1.5rem, 4vw, 2.8rem);
      line-height: 1.45;
      color: #e4dac8;
      max-width: 22ch;
      margin: 0 auto clamp(3rem, 6vw, 5rem);
    }

    /* Social tiles grid */
    .socials {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(4, 72px);
      gap: 10px;
      justify-content: center;
    }

    /* Last row: centre the remaining items */
    .socials li:nth-child(5) { grid-column: 1; }
    .socials li:nth-child(6) { grid-column: 2; }
    .socials li:nth-child(7) { grid-column: 3; }

    .socials a {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      width: 72px;
      height: 72px;
      border: 1px solid rgba(112, 64, 184, 0.18);
      text-decoration: none;
      color: #806878;
      transition: border-color 0.3s ease, box-shadow 0.3s ease, color 0.3s ease;
    }
    .socials a:hover {
      border-color: rgba(112, 64, 184, 0.55);
      box-shadow: 0 0 16px rgba(112, 64, 184, 0.18);
      color: #f5d060;
    }

    .socials svg {
      width: 22px;
      height: 22px;
      display: block;
      fill: none;
      stroke: #7040b8;
      stroke-width: 1.4;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition: stroke 0.3s ease;
      flex-shrink: 0;
    }
    .socials a:hover svg { stroke: #f5d060; }

    .socials span {
      font-family: 'Cinzel', serif;
      font-size: 0.5rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      transition: color 0.3s ease;
    }

    /* Vignette */
    .page::after {
      content: '';
      position: fixed;
      inset: 0;
      background: radial-gradient(ellipse at center, transparent 40%, rgba(5,4,9,0.7) 100%);
      pointer-events: none;
      z-index: 1;
    }

    @media (max-width: 380px) {
      .socials { grid-template-columns: repeat(3, 72px); }
      .socials li:nth-child(5),
      .socials li:nth-child(6),
      .socials li:nth-child(7) { grid-column: auto; }
    }
  </style>
</head>

<body>
  <canvas id="grain" aria-hidden="true"></canvas>

  <main class="page">
    <div class="inner">
      <img src="/ui/logo.gif" alt="White Owl Studio" class="logo" />
      <p class="studio-name">White Owl Studio</p>
      <p class="message">Breath, something new<br/>is growing here.</p>

      <ul class="socials">

        <li>
          <a href="https://www.instagram.com/whiteowlstudio" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5"/>
              <circle cx="12" cy="12" r="4.5"/>
              <circle cx="17.5" cy="6.5" r="1" fill="#7040b8" stroke="none"/>
            </svg>
            <span>Instagram</span>
          </a>
        </li>

        <li>
          <a href="https://www.youtube.com/@OwlsDescent" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="2" y="5" width="20" height="14" rx="4"/>
              <polygon points="10,9 10,15 16,12" fill="#7040b8" stroke="none"/>
            </svg>
            <span>YouTube</span>
          </a>
        </li>

        <li>
          <a href="https://www.facebook.com/whiteowlstudio" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <path d="M15 8h-2a2 2 0 0 0-2 2v2H9v3h2v5h3v-5h2l1-3h-3v-2z" fill="#7040b8" stroke="none"/>
            </svg>
            <span>Facebook</span>
          </a>
        </li>

        <li>
          <a href="https://www.linkedin.com/company/whiteowl-studio" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="3"/>
              <path d="M7 10v7M7 7v.5M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/>
            </svg>
            <span>LinkedIn</span>
          </a>
        </li>

        <li>
          <a href="https://www.tiktok.com/@whiteowl376" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>
            </svg>
            <span>TikTok</span>
          </a>
        </li>

        <li>
          <a href="https://ko-fi.com/whiteowlanimation" target="_blank" rel="noopener noreferrer" aria-label="Ko-Fi">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18 8h1a4 4 0 0 1 0 8h-1"/>
              <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
              <line x1="6" y1="1" x2="6" y2="4"/>
              <line x1="10" y1="1" x2="10" y2="4"/>
              <line x1="14" y1="1" x2="14" y2="4"/>
            </svg>
            <span>Ko-Fi</span>
          </a>
        </li>

        <li>
          <a href="mailto:michaelbjacob@gmail.com" aria-label="Email">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="M2 7l10 7 10-7"/>
            </svg>
            <span>Email</span>
          </a>
        </li>

      </ul>
    </div>
  </main>

  <script>
    const canvas = document.getElementById('grain');
    const ctx    = canvas.getContext('2d');
    let W = 0, H = 0;
    function resize() { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }
    resize();
    window.addEventListener('resize', resize);
    function drawGrain() {
      ctx.clearRect(0, 0, W, H);
      const n = Math.floor(W * H * 0.00014);
      for (let i = 0; i < n; i++) {
        ctx.beginPath();
        ctx.arc(Math.random()*W, Math.random()*H, 0.4+Math.random()*0.9, 0, Math.PI*2);
        ctx.fillStyle = `rgba(245,208,96,${0.008+Math.random()*0.022})`;
        ctx.fill();
      }
      setTimeout(drawGrain, 160);
    }
    drawGrain();
    document.addEventListener('visibilitychange', () => { if (!document.hidden) drawGrain(); });
  </script>
</body>
</html>
