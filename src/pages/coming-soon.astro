---
// Standalone — no Base.astro, no nav, no footer
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>White Owl Studio</title>
  <meta name="description" content="Something new is growing here." />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/ui/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500&family=Crimson+Pro:ital,wght@0,300;1,300;1,400&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body { min-height: 100vh; background: #050409; color: #e4dac8; font-family: 'Crimson Pro', Georgia, serif; }

    .page {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: clamp(3rem, 8vw, 6rem) clamp(1.5rem, 6vw, 4rem);
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    /* Background grain — warm gold speckles, 6fps, behind content */
    #grain-bg {
      position: fixed; inset: 0;
      pointer-events: none; z-index: 1;
      mix-blend-mode: screen;
    }
    /* Top grain — dark micro-dots overlay */
    #grain-top {
      position: fixed; inset: 0;
      pointer-events: none; z-index: 9999;
      mix-blend-mode: overlay; opacity: 0.55;
    }
    /* Top edge blur — matches rest of site */
    .edge-blur {
      position: fixed; left: 0; right: 0; height: 72px;
      pointer-events: none; z-index: 10;
      backdrop-filter: blur(2px);
      -webkit-backdrop-filter: blur(2px);
      top: 0;
      background: linear-gradient(to bottom, rgba(5,4,9,0.30) 0%, rgba(5,4,9,0.0) 65%);
      mask-image: linear-gradient(to bottom, black 0%, black 35%, transparent 100%);
      -webkit-mask-image: linear-gradient(to bottom, black 0%, black 35%, transparent 100%);
    }

    .inner { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; }

    .logo { width: clamp(56px, 10vw, 80px); height: auto; margin-bottom: 1rem; display: block; }

    .studio-name {
      font-family: 'Cinzel', serif;
      font-size: clamp(0.6rem, 1.2vw, 0.75rem);
      letter-spacing: 0.35em;
      text-transform: uppercase;
      color: #f5d060;
      opacity: 0.65;
      margin-bottom: clamp(3rem, 6vw, 5rem);
    }

    .message {
      font-family: 'Crimson Pro', serif;
      font-style: italic;
      font-weight: 300;
      font-size: clamp(1.5rem, 4vw, 2.8rem);
      line-height: 1.45;
      color: #e4dac8;
      max-width: 22ch;
      margin: 0 auto clamp(3rem, 6vw, 5rem);
    }

    /* Social tiles grid */
    .socials {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(4, 72px);
      gap: 10px;
      justify-content: center;
    }

    /* Last row: centre the remaining items */
    .socials li:nth-child(5) { grid-column: 1; }
    .socials li:nth-child(6) { grid-column: 2; }
    .socials li:nth-child(7) { grid-column: 3; }

    .socials a {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      width: 72px;
      height: 72px;
      border: 1px solid rgba(112, 64, 184, 0.18);
      text-decoration: none;
      color: #806878;
      transition: border-color 0.3s ease, box-shadow 0.3s ease, color 0.3s ease;
    }
    .socials a:hover {
      border-color: rgba(112, 64, 184, 0.55);
      box-shadow: 0 0 16px rgba(112, 64, 184, 0.18);
      color: #f5d060;
    }

    .socials svg {
      width: 22px;
      height: 22px;
      display: block;
      fill: none;
      stroke: #7040b8;
      stroke-width: 1.4;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition: stroke 0.3s ease;
      flex-shrink: 0;
    }
    .socials a:hover svg { stroke: #f5d060; }

    .socials span {
      font-family: 'Cinzel', serif;
      font-size: 0.62rem;
      letter-spacing: 0.03em;
      transition: color 0.3s ease;
    }

    /* Purple ambient glow — brightens background so logo is readable */
    .page::before {
      content: '';
      position: fixed;
      inset: 0;
      background: radial-gradient(ellipse 70% 55% at 50% 44%, rgba(112,64,184,0.28) 0%, rgba(60,20,120,0.10) 55%, transparent 80%);
      pointer-events: none;
      z-index: 0;
    }

    /* Vignette */
    .page::after {
      content: '';
      position: fixed;
      inset: 0;
      background: radial-gradient(ellipse at center, transparent 40%, rgba(5,4,9,0.7) 100%);
      pointer-events: none;
      z-index: 1;
    }

    /* ── Launch list + survey ── */
    .signup {
      width: min(92vw, 420px);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0;
      margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
    }

    /* Reveal trigger — the resting-state CTA. Collapses away when the form opens.
       Aura: a soft gold glow fades in ~1s after load, then breathes gently. The page's
       #grain-top overlay sits above it, giving the glow a subtle grainy texture. */
    .reveal {
      font-family: 'Cinzel', serif;
      font-size: 0.8rem;
      letter-spacing: 0.06em;
      color: #050409;
      background: #f5d060;
      border: 1px solid #f5d060;
      padding: 0.8rem 2.4rem;
      cursor: pointer;
      overflow: hidden;
      transition: transform 0.15s ease, filter 0.3s ease,
                  max-height 0.5s cubic-bezier(.22,.61,.36,1),
                  opacity 0.35s ease, padding 0.5s cubic-bezier(.22,.61,.36,1),
                  margin 0.5s cubic-bezier(.22,.61,.36,1);
      max-height: 4rem;
      animation: revealAuraIn 1.6s ease 1s both,
                 revealAuraPulse 3.8s ease-in-out 2.6s infinite;
    }
    .reveal:hover { filter: brightness(1.06); transform: translateY(-1px); }
    .reveal:active { transform: translateY(1px); }
    .signup.open .reveal {
      max-height: 0;
      padding-top: 0;
      padding-bottom: 0;
      margin: 0;
      opacity: 0;
      pointer-events: none;
      border-width: 0;
      animation: none;
    }

    /* one-time fade-in of the glow, then a slow breathing pulse (aligned start value) */
    @keyframes revealAuraIn {
      from { box-shadow: 0 0 0 0 rgba(245, 208, 96, 0); }
      to   { box-shadow: 0 0 16px 1px rgba(245, 208, 96, 0.16); }
    }
    @keyframes revealAuraPulse {
      0%, 100% { box-shadow: 0 0 16px 1px rgba(245, 208, 96, 0.16); }
      50%      { box-shadow: 0 0 30px 5px rgba(245, 208, 96, 0.30); }
    }

    /* Collapsible body — grid-rows 0fr→1fr animates the natural height, pushing socials down. */
    .form-body {
      display: grid;
      grid-template-rows: 0fr;
      width: 100%;
      opacity: 0;
      transition: grid-template-rows 0.55s cubic-bezier(.22,.61,.36,1), opacity 0.5s ease;
    }
    .signup.open .form-body { grid-template-rows: 1fr; opacity: 1; }
    .form-body-inner {
      overflow: hidden;
      min-height: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      padding-top: 0.25rem;
    }

    @media (prefers-reduced-motion: reduce) {
      .reveal, .form-body { transition-duration: 0.01ms; }
      .reveal { animation: none; box-shadow: 0 0 16px 1px rgba(245, 208, 96, 0.16); }
    }

    .signup-lead {
      font-family: 'Cinzel', serif;
      font-size: clamp(0.78rem, 1.4vw, 0.95rem);
      letter-spacing: 0.06em;
      color: #f5d060;
      opacity: 0.8;
    }
    .field { width: 100%; }
    .signup input[type="email"],
    .signup textarea {
      width: 100%;
      background: rgba(10, 8, 20, 0.55);
      border: 1px solid rgba(112, 64, 184, 0.28);
      color: #e4dac8;
      font-family: 'Crimson Pro', serif;
      font-size: 1rem;
      padding: 0.7rem 0.9rem;
      outline: none;
      transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }
    .signup textarea {
      resize: vertical;
      min-height: 2.7rem;
      font-style: italic;
      font-weight: 300;
    }
    .signup input::placeholder,
    .signup textarea::placeholder { color: #806878; font-style: italic; }
    .signup input[type="email"]:focus,
    .signup textarea:focus {
      border-color: rgba(112, 64, 184, 0.6);
      box-shadow: 0 0 14px rgba(112, 64, 184, 0.2);
    }

    /* interest chips */
    .interests {
      border: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
    }
    .interests legend {
      font-family: 'Cinzel', serif;
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      color: #806878;
      margin-bottom: 0.6rem;
      width: 100%;
      text-align: center;
    }
    .chip {
      cursor: pointer;
      font-family: 'Cinzel', serif;
      font-size: 0.75rem;
      letter-spacing: 0.02em;
      color: #806878;
      padding: 0.45rem 0.8rem;
      border: 1px solid rgba(112, 64, 184, 0.22);
      transition: color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
      user-select: none;
    }
    .chip input { position: absolute; opacity: 0; pointer-events: none; }
    .chip:hover { border-color: rgba(112, 64, 184, 0.5); color: #e4dac8; }
    .chip:has(input:checked) {
      color: #f5d060;
      border-color: rgba(245, 208, 96, 0.5);
      background: rgba(112, 64, 184, 0.12);
      box-shadow: 0 0 12px rgba(112, 64, 184, 0.18);
    }
    .chip:has(input:focus-visible) { outline: 1px dashed rgba(245, 208, 96, 0.6); outline-offset: 3px; }

    .submit {
      font-family: 'Cinzel', serif;
      font-size: 0.8rem;
      letter-spacing: 0.06em;
      color: #050409;
      background: #f5d060;
      border: 1px solid #f5d060;
      padding: 0.75rem 2.2rem;
      cursor: pointer;
      transition: box-shadow 0.3s ease, transform 0.15s ease, opacity 0.3s ease;
    }
    .submit:hover { box-shadow: 0 0 20px rgba(245, 208, 96, 0.35); }
    .submit:active { transform: translateY(1px); }
    .submit:disabled { opacity: 0.5; cursor: default; box-shadow: none; }

    .form-status {
      font-family: 'Crimson Pro', serif;
      font-style: italic;
      font-size: 0.95rem;
      min-height: 1.2rem;
      color: #806878;
    }
    .form-status.ok  { color: #f5d060; }
    .form-status.err { color: #c98b8b; }

    /* honeypot — hidden from humans, offered to bots */
    .hp {
      position: absolute !important;
      left: -9999px !important;
      width: 1px; height: 1px;
      opacity: 0; pointer-events: none;
    }

    /* success: collapse the inputs, leave only the closing line */
    .signup.done .signup-lead,
    .signup.done .field,
    .signup.done .interests,
    .signup.done textarea,
    .signup.done .submit { display: none; }
    .signup.done .form-body-inner { padding-top: 0; }

    /* Owl easter egg — a whisper at the very bottom. Muted until you look for it. */
    .owl-whisper {
      display: inline-block;
      margin-top: clamp(2.5rem, 6vw, 4rem);
      font-family: 'Crimson Pro', serif;
      font-style: italic;
      font-weight: 300;
      font-size: 0.8rem;
      letter-spacing: 0.02em;
      color: rgba(128, 104, 120, 0.55);
      text-decoration: none;
      transition: color 0.4s ease;
    }
    .owl-whisper:hover,
    .owl-whisper:focus-visible { color: #f5d060; }

    @media (max-width: 380px) {
      .socials { grid-template-columns: repeat(3, 72px); }
      .socials li:nth-child(5),
      .socials li:nth-child(6),
      .socials li:nth-child(7) { grid-column: auto; }
    }
  </style>
</head>

<body>
  <canvas id="grain-bg"  aria-hidden="true"></canvas>
  <canvas id="grain-top" aria-hidden="true"></canvas>
  <div class="edge-blur" aria-hidden="true"></div>

  <main class="page">
    <div class="inner">
      <img src="/ui/logo.webp" alt="White Owl Studio" class="logo" width="200" height="166" />
      <p class="studio-name">White Owl Studio</p>
      <p class="message">Breathe, something new<br/>is growing here.</p>

      <form class="signup" id="signup-form" novalidate>
        <button type="button" class="reveal" id="reveal-btn" aria-expanded="false" aria-controls="form-body">Join the list</button>

        <div class="form-body" id="form-body">
          <div class="form-body-inner">
            <p class="signup-lead">Be first through the door</p>

            <div class="field">
              <input
                type="email" id="email" name="email" required
                placeholder="Your email address" autocomplete="email"
                aria-label="Email address"
              />
            </div>

            <fieldset class="interests">
              <legend>What brings you here?</legend>
              <label class="chip"><input type="checkbox" name="interests" value="animation" />Looking for animation</label>
              <label class="chip"><input type="checkbox" name="interests" value="work"      />Work / opportunities</label>
              <label class="chip"><input type="checkbox" name="interests" value="content"   />Extra WOS content</label>
              <label class="chip"><input type="checkbox" name="interests" value="merch"     />Witchy merch</label>
            </fieldset>

            <textarea
              id="message" name="message" rows="2" maxlength="1000"
              placeholder="Anything you'd love to see? (optional)"
              aria-label="Optional message"></textarea>

            <!-- honeypot: hidden from humans, catches bots -->
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp" />

            <button type="submit" class="submit">Join the mailing list</button>
            <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
          </div>
        </div>
      </form>

      <ul class="socials">

        <li>
          <a href="https://www.instagram.com/whiteowlstudio" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5"/>
              <circle cx="12" cy="12" r="4.5"/>
              <circle cx="17.5" cy="6.5" r="1" fill="#7040b8" stroke="none"/>
            </svg>
            <span>Instagram</span>
          </a>
        </li>

        <li>
          <a href="https://www.youtube.com/shorts/pTbSSnQsZ2E" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="2" y="5" width="20" height="14" rx="4"/>
              <polygon points="10,9 10,15 16,12" fill="#7040b8" stroke="none"/>
            </svg>
            <span>YouTube</span>
          </a>
        </li>

        <li>
          <a href="https://www.facebook.com/profile.php?id=61590287245120" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <path d="M15 8h-2a2 2 0 0 0-2 2v2H9v3h2v5h3v-5h2l1-3h-3v-2z" fill="#7040b8" stroke="none"/>
            </svg>
            <span>Facebook</span>
          </a>
        </li>

        <li>
          <a href="https://www.linkedin.com/company/whiteowl-studio" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="3"/>
              <path d="M7 10v7M7 7v.5M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/>
            </svg>
            <span>LinkedIn</span>
          </a>
        </li>

        <li>
          <a href="https://www.tiktok.com/@whiteowl376" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>
            </svg>
            <span>TikTok</span>
          </a>
        </li>

        <li>
          <a href="https://ko-fi.com/whiteowlanimation" target="_blank" rel="noopener noreferrer" aria-label="Ko-Fi">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18 8h1a4 4 0 0 1 0 8h-1"/>
              <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
              <line x1="6" y1="1" x2="6" y2="4"/>
              <line x1="10" y1="1" x2="10" y2="4"/>
              <line x1="14" y1="1" x2="14" y2="4"/>
            </svg>
            <span>Ko-Fi</span>
          </a>
        </li>

        <li>
          <a href="mailto:hello@whiteowlhub.com" aria-label="Email">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="M2 7l10 7 10-7"/>
            </svg>
            <span>Email</span>
          </a>
        </li>

      </ul>

      <a class="owl-whisper" href="https://www.owlresearchinstitute.org/snowy-owls-take-the-journey" target="_blank" rel="noopener noreferrer">Were you hoping to find actual white owls?</a>
    </div>
  </main>

  <script>
    const bgCanvas  = document.getElementById('grain-bg') as HTMLCanvasElement;
    const topCanvas = document.getElementById('grain-top') as HTMLCanvasElement;
    const bgCtx     = bgCanvas.getContext('2d')!;
    const topCtx    = topCanvas.getContext('2d')!;
    let w = 0, h = 0;

    function resize() {
      w = bgCanvas.width  = topCanvas.width  = window.innerWidth;
      h = bgCanvas.height = topCanvas.height = window.innerHeight;
      drawTopGrain();
    }

    function drawBgGrain() {
      if (!w || !h) return;
      bgCtx.clearRect(0, 0, w, h);
      const count = (w * h * 0.0003) | 0;
      for (let i = 0; i < count; i++) {
        const x = Math.random() * w, y = Math.random() * h;
        const rx = Math.random() * 0.45 + 0.08;
        const ry = rx * (0.6 + Math.random() * 0.8);
        const rot = Math.random() * Math.PI;
        const a = Math.random() * 0.22 + 0.14;
        const warm = (Math.random() * 25) | 0;
        bgCtx.beginPath();
        bgCtx.ellipse(x, y, rx, ry, rot, 0, 6.2832);
        bgCtx.fillStyle = `rgba(${215+warm},${148+(warm>>1)},${52+(warm>>2)},${a})`;
        bgCtx.fill();
      }
    }

    function drawTopGrain() {
      if (!w || !h) return;
      topCtx.clearRect(0, 0, w, h);
      const count = (w * h * 0.004) | 0;
      for (let i = 0; i < count; i++) {
        const x = Math.random() * w, y = Math.random() * h;
        const rx = Math.random() * 0.3 + 0.06;
        const ry = rx * (0.5 + Math.random() * 0.9);
        topCtx.beginPath();
        topCtx.ellipse(x, y, rx, ry, Math.random()*Math.PI, 0, 6.2832);
        topCtx.fillStyle = `rgba(10,8,18,${Math.random()*0.035+0.005})`;
        topCtx.fill();
      }
    }

    resize();
    window.addEventListener('resize', resize, { passive: true });
    let grainTimer = setInterval(drawBgGrain, 1000 / 6);
    drawBgGrain();
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { clearInterval(grainTimer); }
      else { grainTimer = setInterval(drawBgGrain, 1000/6); drawBgGrain(); }
    });

    /* ── Launch-list signup ── */
    const form      = document.getElementById('signup-form') as HTMLFormElement;
    const statusEl  = document.getElementById('form-status') as HTMLParagraphElement;
    const submitBtn = form.querySelector('.submit') as HTMLButtonElement;
    const revealBtn = document.getElementById('reveal-btn') as HTMLButtonElement;
    const emailInput = document.getElementById('email') as HTMLInputElement;
    const EMAIL_RE  = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    /* Reveal: open the form with an eased expand, then focus the email field. */
    revealBtn.addEventListener('click', () => {
      form.classList.add('open');
      revealBtn.setAttribute('aria-expanded', 'true');
      // Wait for the expand to settle before focusing (avoids scroll jump mid-animation).
      window.setTimeout(() => emailInput.focus({ preventScroll: true }), 480);
    });

    function setStatus(msg: string, kind: '' | 'ok' | 'err') {
      statusEl.textContent = msg;
      statusEl.className = 'form-status' + (kind ? ' ' + kind : '');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const email     = String(fd.get('email') || '').trim();
      const interests = fd.getAll('interests').map(String);
      const message   = String(fd.get('message') || '').trim();
      const website   = String(fd.get('website') || ''); // honeypot

      if (!EMAIL_RE.test(email)) {
        setStatus('Please enter a valid email.', 'err');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
      setStatus('', '');

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, interests, message, website }),
        });
        const out = await res.json().catch(() => ({}));
        if (res.ok && out.ok) {
          form.classList.add('done');
          setStatus('Welcome, fellow traveler. We’ll be in touch.', 'ok');
        } else {
          setStatus(out.error || 'Something went wrong. Please try again.', 'err');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Join the mailing list';
        }
      } catch {
        setStatus('Network error. Please try again.', 'err');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Join the list';
      }
    });
  </script>
</body>
</html>
